+    if !can_bind_loopback() {
+        return;
+    }
+    let mut vars = common::env_lock().await;
+    vars.set("SHUNT_TEST_BUSY_A", "fixture-busy-a");
+    vars.set("SHUNT_TEST_BUSY_B", "fixture-busy-b");
+    let upstream = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/messages"))
+        .and(BearerToken("fixture-busy-b".into()))
+        .respond_with(
+            ResponseTemplate::new(429)
+                .insert_header("anthropic-ratelimit-unified-status", "rejected")
+                .insert_header(
+                    "anthropic-ratelimit-unified-representative-claim",
+                    "seven_day",
+                )
+                .set_body_string(
+                    r#"{"error":{"type":"rate_limit_error","message":"weekly limit"}}"#,
+                ),
+        )
+        .expect(1)
+        .mount(&upstream)
+        .await;
+    Mock::given(method("POST"))
+        .and(path("/v1/messages"))
+        .and(BearerToken("fixture-busy-a".into()))
+        .respond_with(ResponseTemplate::new(200).set_body_string(r#"{"account":"a"}"#))
+        .expect(1)
+        .mount(&upstream)
+        .await;
+    let a = account("a", "SHUNT_TEST_BUSY_A", "uuid-busy-a");
+    let mut config = test_config(
+        &upstream.uri(),
+        a.clone(),
+        account("b", "SHUNT_TEST_BUSY_B", "uuid-busy-b"),
+    );
+    config.server.pool = Some(shunt::config::PoolConfig {
+        ramp_initial_concurrency: Some(1),
+        ..Default::default()
+    });
+    let (gateway, state) = start_gateway_with_state(config).await;
+    let _held = state
+        .accounts
+        .clone()
+        .try_admit("anthropic", &a, 1, false)
+        .unwrap();
+    let response = post_messages(&gateway, None).await;
+    assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+    assert_eq!(response.headers()["retry-after"], "1");
+    assert!(!response.text().await.unwrap().contains("weekly"));
+    let resumed = post_messages(&gateway, None).await;
+    assert_eq!(resumed.status(), StatusCode::OK);
+    assert_eq!(resumed.headers()["x-shunt-account"], "a");
+    upstream.verify().await;
