+// Drain the POST before closing a fault response; unread request bytes can
+// make the OS reset the socket and discard the SSE we intended to test.
+async fn drain_fixture_request(socket: &mut tokio::net::TcpStream) {
+    use tokio::io::{AsyncBufReadExt, AsyncReadExt};
+    let mut reader = tokio::io::BufReader::new(socket);
+    let mut length = 0;
+    loop {
+        let mut line = String::new();
+        assert!(reader.read_line(&mut line).await.unwrap() > 0);
+        if line == "\r\n" {
+            break;
+        }
+        if let Some((name, value)) = line.split_once(':') {
+            if name.eq_ignore_ascii_case("content-length") {
+                length = value.trim().parse::<usize>().unwrap();
+            }
+        }
+    }
+    assert!(length < 1024 * 1024);
+    reader.read_exact(&mut vec![0; length]).await.unwrap();
+}
