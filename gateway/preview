def build_parser():
    p = argparse.ArgumentParser(prog="preview", description=HELP, formatter_class=argparse.RawDescriptionHelpFormatter,
                                usage="preview <port> [--name LABEL] | file <path> [--name LABEL] | cua [--name LABEL] | list [--json] | "
                                      "stop <port>|<path>|cua|--all | doctor")
    p.add_argument("--version", action="version", version=f"preview {VERSION}")
    return p


def parse(argv):
    """Small hand-rolled dispatcher so `preview 5173` works without a subcommand word."""
    parser = build_parser()
    if not argv or argv[0] in ("-h", "--help", "help"):
        parser.print_help()
        raise SystemExit(0)
    if argv[0] == "--version":
        parser.parse_args(argv)
    cmd = argv[0]
    if cmd == "list":
        sp = argparse.ArgumentParser(prog="preview list")
        sp.add_argument("--json", action="store_true")
        a = sp.parse_args(argv[1:])
        return "list", a
    if cmd == "stop":
        sp = argparse.ArgumentParser(prog="preview stop",
                                     usage="preview stop <port> | preview stop <path> | preview stop cua | preview stop --all")
        sp.add_argument("target", nargs="?", metavar="port|path")
        sp.add_argument("--all", action="store_true", help="stop every preview created by this tool")
        a = sp.parse_args(argv[1:])
        if (a.target is not None) == bool(a.all):
            sp.error("give exactly one of <port>, <path> or --all")
        a.port = a.path = None
        a.cua = a.target == "cua"
        if a.cua:
            pass
        elif a.target is not None and a.target.isdigit():
            try:
                a.port = check_port(a.target)
            except argparse.ArgumentTypeError as e:
                sp.error(str(e))
        elif a.target is not None:
            a.path = a.target
        return "stop", a
    if cmd == "file":
        sp = argparse.ArgumentParser(prog="preview file", usage="preview file <path> [--name LABEL]")
        sp.add_argument("path")
        sp.add_argument("--name", "--label", dest="name", help="short label shown in preview list")
        return "file", sp.parse_args(argv[1:])
    if cmd == "cua":
        sp = argparse.ArgumentParser(prog="preview cua", usage="preview cua [--name LABEL]")
        sp.add_argument("--name", "--label", dest="name", help="short label shown in preview list")
        return "cua", sp.parse_args(argv[1:])
    if cmd == "_cua-viewer":
        sp = argparse.ArgumentParser(prog="preview _cua-viewer")
        sp.add_argument("--cua", required=True)
        sp.add_argument("--port", required=True, type=int)
        sp.add_argument("--key-file", required=True)
        return "_cua-viewer", sp.parse_args(argv[1:])
    if cmd == "_serve-file":
        sp = argparse.ArgumentParser(prog="preview _serve-file")
        sp.add_argument("--root", required=True)
        sp.add_argument("--port", required=True, type=int)
        return "_serve-file", sp.parse_args(argv[1:])
    if cmd == "doctor":
        argparse.ArgumentParser(prog="preview doctor").parse_args(argv[1:])
        return "doctor", None
    if cmd == "_serve":
        sp = argparse.ArgumentParser(prog="preview _serve")
        sp.add_argument("--listen", required=True)
        sp.add_argument("--target", required=True, type=int)
        sp.add_argument("--public-url")
        sp.add_argument("--tailnet-ip")
        sp.add_argument("--upstream-host")
        sp.add_argument("--key-file")
        sp.add_argument("--owner-login")
        return "_serve", sp.parse_args(argv[1:])
    if cmd == "start":
        argv = argv[1:]
    sp = argparse.ArgumentParser(prog="preview", usage="preview <port> [--name LABEL]")
    sp.add_argument("port", type=check_port)
    sp.add_argument("--name", "--label", dest="name", help="short label shown in preview list")
    return "start", sp.parse_args(argv)


def main(argv=None, sysm=None):
    cmd, a = parse(sys.argv[1:] if argv is None else argv)
    if cmd == "_serve":
        return cmd_serve(a)
    if cmd == "_serve-file":
        return cmd_serve_file(a)
    if cmd == "_cua-viewer":
        return cmd_cua_viewer(a)
    sysm = sysm or System()
    if cmd == "list":
        return cmd_list(sysm, a.json)
    if cmd == "stop":
        return cmd_stop(sysm, a.port, a.all, path=a.path, cua=a.cua)
    if cmd == "file":
        return cmd_file(sysm, a.path, a.name)
    if cmd == "cua":
        return cmd_cua(sysm, a.name)
    if cmd == "doctor":
        return cmd_doctor(sysm)
    return cmd_start(sysm, a.port, a.name)


if __name__ == "__main__":
    sys.exit(main())
