    return True


def content_disposition(kind, name):
    """`inline` or `attachment` with a safely quoted filename (RFC 6266 / RFC 5987 for anything not plain ASCII)."""
    fallback = "".join(c if 32 <= ord(c) < 127 and c not in '"\\' else "_" for c in name) or "file"
    value = f'{kind}; filename="{fallback}"'
    if fallback != name:
        value += "; filename*=UTF-8''" + urllib.parse.quote(name, safe="")
    return value


_BYTE_RANGE = re.compile(r"\s*([0-9]*)-([0-9]*)\s*")


def byte_range(value, size):
    """The one byte range a Range header asks for in a file of `size` bytes: (first, last), "unsatisfiable" when no
    byte of the file is in it, or None to ignore the header (another unit, several ranges, a malformed range)."""
    unit, sep, spec = value.partition("=")
    m = _BYTE_RANGE.fullmatch(spec)
    if not sep or unit.strip().lower() != "bytes" or not m or not (m[1] or m[2]):
        return None
    try:
        first, last = (int(m[1]) if m[1] else None), (int(m[2]) if m[2] else None)
    except ValueError:  # more digits than int() takes
        return None
    if first is None:  # the last `last` bytes
        return (max(size - last, 0), size - 1) if last and size else "unsatisfiable"
    if last is not None and last < first:
        return None
    if first >= size:
        return "unsatisfiable"
    return first, size - 1 if last is None else min(last, size - 1)


def if_range_ok(value, etag, modified):
    """True when If-Range (None: not sent) names this version of the file: its strong ETag or its Last-Modified."""
    if value is None:
        return True
    value = value.strip()
    if value.startswith('"'):
        return value == etag
    try:
        when = email.utils.parsedate_to_datetime(value)
    except (TypeError, ValueError, OverflowError):
        return False  # a weak ETag (W/"...") or no date
    if when.tzinfo is None:  # an asctime date has no zone; HTTP dates are GMT
        when = when.replace(tzinfo=datetime.timezone.utc)
    return when == email.utils.parsedate_to_datetime(modified)


