class FileShareRefused(ValueError):
    pass


def hidden(parts):
    """True if any path component starts with a dot (dotfiles, dot folders, and . or ..)."""
    return any(part.startswith(".") for part in parts)


def check_share_root(path):
    """The resolved path to share, or FileShareRefused for anything that must never be shared."""
    if CONTROL_CHARS.search(str(path)):
        raise FileShareRefused("refusing to share a path that contains control characters")
    raw = Path(os.path.expanduser(str(path)))
    try:
        resolved = raw.resolve(strict=True)
    except (OSError, RuntimeError, ValueError):
        raise FileShareRefused(f"{path}: no such file or folder")
    if CONTROL_CHARS.search(str(resolved)):
        raise FileShareRefused(f"refusing to share {path}: the real path contains control characters")
    if any(resolved == system or resolved.is_relative_to(system) for system in SYSTEM_ROOTS):
        raise FileShareRefused(f"refusing to share {path}: system folders (/proc, /sys, /dev, /run) are never shared")
    if hidden(Path(os.path.abspath(raw)).parts) or hidden(resolved.parts):
        raise FileShareRefused(f"refusing to share {path}: dotfiles and dot folders (like ~/.ssh) are never shared")
    if resolved == Path(resolved.anchor):
        raise FileShareRefused("refusing to share /: pick one file or folder")
    home = Path.home().resolve()
    if resolved == home or home.is_relative_to(resolved):
        raise FileShareRefused(f"refusing to share {path}: that is the home folder (or contains it); "
                               f"pick one file or folder inside it")
    if not (resolved.is_file() or resolved.is_dir()):
        raise FileShareRefused(f"refusing to share {path}: not a regular file or folder")
    return resolved


def resolve_request(root, single, request_path):
    """The file or folder a request path names inside the share, or None (404)."""
    path = request_path.split("#", 1)[0]
    try:
        path = urllib.parse.unquote(path, errors="strict")
    except UnicodeDecodeError:
        return None
    if not path.startswith("/") or "\x00" in path:
        return None
    parts = [part for part in path.split("/") if part not in ("", ".")]
    if hidden(parts):  # also catches ".."
        return None
    if single:
        return root if parts in ([], [root.name]) else None
    try:
        target = root.joinpath(*parts).resolve(strict=True)
    except (OSError, RuntimeError, ValueError):
        return None
    if target != root and not target.is_relative_to(root):
        return None  # a symlink that points outside the shared folder
    if hidden(target.relative_to(root).parts):
        return None  # a symlink that points at a dotfile inside the shared folder
    return target


def looks_like_text(head):
    if b"\x00" in head:
        return False
    try:
        codecs.getincrementaldecoder("utf-8")().decode(head, final=False)
