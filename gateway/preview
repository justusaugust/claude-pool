def _md_table_sep(line):
    cells = line.strip()
    if "|" not in cells:
        return False
    cells = cells[1:] if cells.startswith("|") else cells
    cells = cells[:-1] if cells.endswith("|") else cells
    return all(re.fullmatch(r":?-+:?", cell.strip()) for cell in cells.split("|"))


def _md_destination(text, j, end):
    """Parse `url` or `<url>`, an optional "title" and the closing `)`, starting just after `(`.
    Returns (url, title, index after the `)`) or None. One pass, no backtracking."""
    while j < end and text[j] in _MD_SPACE:
        j += 1
    if j < end and text[j] == "<":
        k = text.find(">", j + 1, end)
        if k < 0 or "<" in text[j + 1:k] or "\n" in text[j + 1:k]:
            return None
        url, j = text[j + 1:k], k + 1
    else:
        start, nested = j, False
        while j < end and text[j] not in _MD_SPACE:
            c = text[j]
            if c in "<>":
                return None
            if c == "(":
                if nested:
                    return None
                nested = True
            elif c == ")":
                if not nested:
                    break
                nested = False
            j += 1
        if nested:
            return None
        url = text[start:j]
    k, title = j, None
    while k < end and text[k] in _MD_SPACE:
        k += 1
    if k > j and k < end and text[k] == '"':
        q = text.find('"', k + 1, end)
        if q < 0 or "\n" in text[k + 1:q]:
            return None
        title, k = text[k + 1:q], q + 1
        while k < end and text[k] in _MD_SPACE:
            k += 1
    if k < end and text[k] == ")":
        return url, title, k + 1
    return None


def md_inline(text, links=True, depth=0):
    if depth > MD_DEPTH:
        return html.escape(text)
    out, i, n = [], 0, len(text)
    marks = {}

    def closer(kind, lo, hi):
        """First closing delimiter of `kind` at a position in [lo, hi], or None."""
        if not marks:
            marks.update({"**": [], "__": [], "*": [], "_": [], "`": {}})
            for m in re.finditer(r"[*_]", text):
                j, c = m.start(), text[m.start()]
                if j == 0 or text[j - 1].isspace():
                    continue
                if text.startswith(c * 2, j):
                    marks[c * 2].append(j)
                if c == "*" and text[j - 1] != "*":
                    marks["*"].append(j)
                if c == "_" and not (j + 1 < n and text[j + 1] in _ASCII_ALNUM):
                    marks["_"].append(j)
            for m in re.finditer(r"`+", text):
                marks["`"].setdefault(m.end() - m.start(), []).append(m.start())
        found = marks[kind[0]].get(len(kind), []) if kind[0] == "`" else marks[kind]
        k = bisect.bisect_left(found, lo)
        return found[k] if k < len(found) and found[k] <= hi else None
    while i < n:
        m = _MD_SPECIAL.search(text, i)
        if not m:
            out.append(html.escape(text[i:]))
            break
        if m.start() > i:
            out.append(html.escape(text[i:m.start()]))
        i = m.start()
        c, end = text[i], min(n, i + MD_SPAN)
        if c == "\\" and i + 1 < n and text[i + 1] in _MD_ESCAPABLE:
            out.append(html.escape(text[i + 1]))
            i += 2
            continue
        if c == "`":
            j = i
            while j < n and text[j] == "`":
                j += 1
            run = j - i
            close = closer("`" * run, j, min(n, j + MD_SPAN) - run)
            if close is not None:
                out.append("<code>" + html.escape(text[j:close].strip(" ") or text[j:close]) + "</code>")
                i = close + run
            else:
                out.append(html.escape(text[i:j]))
                i = j
            continue
        if c == "!" and i + 1 < n and text[i + 1] == "[":
            lm = _MD_LABEL.match(text, i + 1, end)
            dest = lm and _md_destination(text, lm.end(), end)
            if dest:
                label, (url, title, after) = lm.group(1), dest
                if md_url_ok(url, image=True):
                    out.append(f'<img src="{html.escape(url)}" alt="{html.escape(label)}"'
                               + (f' title="{html.escape(title)}"' if title else "") + ">")
                else:
                    out.append(html.escape(label))
                i = after
                continue
        if c == "[":
            lm = _MD_LABEL.match(text, i, end)
            dest = lm and _md_destination(text, lm.end(), end)
            if dest:
                label, (url, title, after) = lm.group(1), dest
                inner = md_inline(label, links=False, depth=depth + 1)
                if links and md_url_ok(url):
                    out.append(f'<a href="{html.escape(url)}"' + (f' title="{html.escape(title)}"' if title else "")
                               + f">{inner}</a>")
                else:
                    out.append(inner)
                i = after
                continue
        if c == "<":
            am = _MD_AUTOLINK.match(text, i, end)
            if am and links and md_url_ok(am.group(1)):
                out.append(f'<a href="{html.escape(am.group(1))}">{html.escape(am.group(1))}</a>')
                i = am.end()
                continue
        if c in "*_" and not (c == "_" and i > 0 and text[i - 1].isalnum()):
            if text.startswith(c * 2, i) and i + 2 < n and not text[i + 2].isspace():
                j = closer(c * 2, i + 3, end - 2)
                if j is not None:
                    out.append("<strong>" + md_inline(text[i + 2:j], links, depth + 1) + "</strong>")
                    i = j + 2
                    continue
            if i + 1 < n and not text[i + 1].isspace() and not (c == "*" and text[i + 1] == "*"):
                j = closer(c, i + 2, end - 1)
                if j is not None:
                    out.append("<em>" + md_inline(text[i + 1:j], links, depth + 1) + "</em>")
                    i = j + 1
                    continue
        out.append(html.escape(c))
        i += 1
    return "".join(out)


def _md_table_cells(line):
    line = line.strip()
    if line.startswith("|"):
        line = line[1:]
    if line.endswith("|") and not line.endswith("\\|"):
        line = line[:-1]
    return [cell.strip() for cell in re.split(r"(?<!\\)\|", line)]


def _md_block_start(line):
    return bool(_MD_FENCE.match(line) or _MD_HEADING.match(line) or _MD_HR.match(line) or _MD_QUOTE.match(line))


def _md_list(lines, i, depth):
    """Parse the list that starts at lines[i]. Returns (html, next index)."""
    items, n = [], len(lines)
    while i < n:
        line = lines[i]
        if not line.strip():
            j = i
            while j < n and not lines[j].strip():
                j += 1
            if j < n and (_MD_ITEM.match(lines[j]) or lines[j].startswith("  ")):
                i = j
                continue
            break
        m = _MD_ITEM.match(line)
        if m and not _MD_HR.match(line):
            items.append({"indent": len(m.group(1)), "ordered": m.group(3) is not None,
                          "start": int(m.group(3) or 1), "text": [m.group(4) or ""]})
        elif items and (line.startswith("  ") or not _md_block_start(line)):
            items[-1]["text"].append(line.strip())
        else:
            break
        i += 1
    return _md_list_html(items, 0, depth)[0], i


def _md_list_html(items, k, depth):
    first = items[k]
    indent, ordered = first["indent"], first["ordered"]
    tag = "ol" if ordered else "ul"
    start = f' start="{first["start"]}"' if ordered and first["start"] != 1 else ""
    parts, current = [f"<{tag}{start}>"], None

    def close():
        if current is not None:
            parts.append("<li>" + md_inline("\n".join(current["text"]).strip(), depth=depth)
                         + "".join(current["children"]) + "</li>")

    while k < len(items):
        item = items[k]
        if item["indent"] < indent:
            break
        if item["indent"] >= indent + 2 and current is not None:
            if depth >= MD_DEPTH:
                current["text"].append(item["text"][0])
                current["text"].extend(item["text"][1:])
                k += 1
                continue
            child, k = _md_list_html(items, k, depth + 1)
            current["children"].append(child)
            continue
        if item["ordered"] != ordered:
            break
        close()
        current = {"text": list(item["text"]), "children": []}
        k += 1
    close()
    parts.append(f"</{tag}>")
    return "".join(parts), k


def md_blocks(raw_lines, depth=0):
    lines = [line.expandtabs(4) for line in raw_lines]
    out, para, i, n = [], [], 0, len(lines)

    def flush():
        if para:
            out.append("<p>" + md_inline("\n".join(p.strip() for p in para), depth=depth) + "</p>")
            para.clear()

    while i < n:
        line = lines[i]
        if not line.strip():
            flush()
            i += 1
            continue
        m = _MD_FENCE.match(line)
        if m and not (m.group(1)[0] == "`" and "`" in m.group(2)):
            flush()
            fence, info = m.group(1), m.group(2).strip()
            closing = re.compile(r"^ {0,3}" + re.escape(fence[0]) + "{%d,}[ \t]*$" % len(fence))
            i += 1
            code = []
            while i < n and not closing.match(lines[i]):
                code.append(raw_lines[i])
                i += 1
            i += 1
            lang = re.sub(r"[^\w+.-]", "", info.split()[0]) if info else ""
            cls = f' class="language-{lang}"' if lang else ""
            out.append(f"<pre><code{cls}>" + html.escape("\n".join(code)) + "</code></pre>")
            continue
        m = _MD_HEADING.match(line)
        if m:
            flush()
            level = len(m.group(1))
            out.append(f"<h{level}>" + md_inline(_md_heading_text(m.group(2)), depth=depth) + f"</h{level}>")
            i += 1
            continue
        if _MD_HR.match(line):
            flush()
            out.append("<hr>")
            i += 1
            continue
        if _MD_QUOTE.match(line):
            flush()
            quoted = []
            while i < n and _MD_QUOTE.match(lines[i]):
                quoted.append(_MD_QUOTE.match(lines[i]).group(1))
                i += 1
            if depth >= MD_DEPTH:
                out.append("<blockquote><p>" + md_inline("\n".join(quoted), depth=depth) + "</p></blockquote>")
            else:
                out.append("<blockquote>" + md_blocks(quoted, depth + 1) + "</blockquote>")
            continue
        if _MD_ITEM.match(line):
            flush()
            listed, i = _md_list(lines, i, depth)
            out.append(listed)
            continue
        if "|" in line and i + 1 < n and _md_table_sep(lines[i + 1]):
            flush()
            head = _md_table_cells(line)
            i += 2
            rows = []
            while i < n and lines[i].strip() and "|" in lines[i]:
                rows.append(_md_table_cells(lines[i]))
                i += 1
            cell = lambda tag, text: f"<{tag}>" + md_inline(text, depth=depth) + f"</{tag}>"
            body = "".join("<tr>" + "".join(cell("td", c) for c in row) + "</tr>" for row in rows)
            out.append("<table><thead><tr>" + "".join(cell("th", c) for c in head) + "</tr></thead>"
                       + (f"<tbody>{body}</tbody>" if body else "") + "</table>")
            continue
        para.append(line)
        i += 1
    flush()
    return "\n".join(out)


def render_markdown(text, title):
    """A complete, self-contained HTML page for a Markdown text (standard library only)."""
    return html_page(title, md_blocks(text.splitlines()))


def index_page(root, folder):
    rel = folder.relative_to(root).parts
    title = "/".join((root.name, *rel))
    rows = []
    if rel:
        parent = "/" + "".join(urllib.parse.quote(part, safe="") + "/" for part in rel[:-1])
        rows.append(f'<li><a href="{html.escape(parent)}">..</a></li>')
    try:
        children = sorted(folder.iterdir(), key=lambda child: child.name)
    except OSError:
        children = []
    for child in children:
        if child.name.startswith("."):
            continue
        try:
            real = child.resolve(strict=True)
            mode = real.stat().st_mode
        except (OSError, RuntimeError):
            continue
        if (real != root and not real.is_relative_to(root)) or hidden(real.relative_to(root).parts):
            continue
        is_dir = stat.S_ISDIR(mode)
        if not (is_dir or stat.S_ISREG(mode)):
            continue
        href = "/" + "/".join(urllib.parse.quote(part, safe="") for part in (*rel, child.name)) + ("/" if is_dir else "")
        rows.append(f'<li><a href="{html.escape(href)}">{html.escape(child.name)}{"/" if is_dir else ""}</a></li>')
    body = f"<h1>{html.escape(title)}</h1>\n<ul class=\"index\">\n" + "\n".join(rows) + "\n</ul>"
    if len(rows) == (1 if rel else 0):
        body += "\n<p>This folder is empty.</p>"
    return html_page(title, body)


def make_file_handler(root, quiet=False):
    """A read-only GET/HEAD handler for one file or one folder. Nothing outside `root`, and no dotfile, is served."""
    root = Path(root).resolve(strict=True)
    single = root.is_file()

    class FileHandler(BaseHTTPRequestHandler):
        server_version = "preview"
        sys_version = ""
        protocol_version = "HTTP/1.1"  # keep-alive: a video's range requests reuse one connection
        timeout = 60  # an idle keep-alive connection ends, so the server can still stop when idle

        def __getattr__(self, name):
            if name.startswith("do_"):
                return self.not_allowed
            raise AttributeError(name)

        def log_message(self, format, *args):
            if not quiet:
                super().log_message(format, *args)

        def send_error(self, code, message=None, explain=None):  # a request it could not parse: the rest is unknown
            self.close_connection = True
            phrase = self.responses.get(code, ("Error",))[0]
            self.send_bytes(code, "text/plain; charset=utf-8", f"{code} {phrase}\n".encode(), OTHER_CSP)

        def not_allowed(self):
            self.close_connection = True  # its body, if any, is never read
            self.send_bytes(405, "text/plain; charset=utf-8", b"Only GET and HEAD are allowed.\n", OTHER_CSP,
                            [("Allow", "GET, HEAD")])

        def not_found(self):
            self.send_bytes(404, "text/plain; charset=utf-8", b"Not found.\n", OTHER_CSP)

        def start(self, code, ctype, length, csp, extra=()):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(length))
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy", csp)
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("Cache-Control", "no-cache")
            if self.close_connection:
                self.send_header("Connection", "close")
            for name, value in extra:
                self.send_header(name, value)
            self.end_headers()

        def send_bytes(self, code, ctype, body, csp, extra=()):
            self.start(code, ctype, len(body), csp, extra)
            if self.command != "HEAD":
                self.wfile.write(body)

        def do_GET(self):
            length = self.headers.get("Content-Length")
            if self.headers.get("Transfer-Encoding") is not None or (length is not None and length.strip() != "0"):
                self.close_connection = True  # its body is never read, so it must not be taken for the next request
            path, _, query = self.path.split("#", 1)[0].partition("?")
            target = resolve_request(root, single, path)
            if target is None:
                return self.not_found()
            if target.is_dir():
                if not path.endswith("/"):  # so relative links in its index.html resolve inside the folder
                    location = "/" + path.lstrip("/\\") + "/" + ("?" + query if query else "")  # never //host or /\host
                    return self.send_bytes(301, "text/plain; charset=utf-8", b"", OTHER_CSP, [("Location", location)])
                page = resolve_request(root, single, path + "index.html")  # the same checks as any request
                if page is not None and page.is_file():
                    return self.send_file(page, query)
                return self.send_bytes(200, "text/html; charset=utf-8", index_page(root, target).encode(), HTML_CSP)
            self.send_file(target, query)

        do_HEAD = do_GET

        def send_file(self, target, query):
            flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
            try:
                fd = os.open(target, flags)
            except OSError:
                return self.not_found()
            with os.fdopen(fd, "rb") as f:
                st = os.fstat(f.fileno())
                if not stat.S_ISREG(st.st_mode):
                    return self.not_found()
                name, ext = target.name, target.suffix.lower()
                raw = urllib.parse.parse_qs(query).get("raw") == ["1"]
                if ext in MARKDOWN_EXTS and not raw and st.st_size <= MARKDOWN_RENDER_LIMIT:
                    text = f.read(MARKDOWN_RENDER_LIMIT + 1).decode("utf-8", "replace")
                    return self.send_bytes(200, "text/html; charset=utf-8", render_markdown(text, name).encode(), HTML_CSP)
                extra, csp = [], OTHER_CSP
                if ext in PAGE_EXTS:
                    ctype, csp = "text/html; charset=utf-8", PAGE_CSP
                elif ext in MARKDOWN_EXTS:
                    ctype = "text/plain; charset=utf-8"
                elif ext in ASSET_TYPES:
                    ctype = ASSET_TYPES[ext]
                elif ext in INLINE_TYPES:
                    ctype = INLINE_TYPES[ext]
                    extra.append(("Content-Disposition", content_disposition("inline", name)))
                else:
                    head = f.read(TEXT_SNIFF)
                    f.seek(0)
                    if looks_like_text(head):
                        ctype = "text/plain; charset=utf-8"
                    else:
                        ctype = "application/octet-stream"
                        extra.append(("Content-Disposition", content_disposition("attachment", name)))
                # Byte ranges let a video start before it is loaded and seek; the ETag keeps a resumed range on one version.
                etag = f'"{st.st_size:x}-{st.st_mtime_ns:x}"'
                modified = email.utils.formatdate(st.st_mtime, usegmt=True)
                extra += [("Accept-Ranges", "bytes"), ("ETag", etag), ("Last-Modified", modified)]
                code, first, last = 200, 0, st.st_size - 1
                wanted = self.headers.get("Range")
                if wanted is not None and if_range_ok(self.headers.get("If-Range"), etag, modified):
                    part = byte_range(wanted, st.st_size)
                    if part == "unsatisfiable":
                        return self.send_bytes(416, "text/plain; charset=utf-8", b"Range not satisfiable.\n", OTHER_CSP,
                                               [("Content-Range", f"bytes */{st.st_size}")])
                    if part is not None:
                        code, (first, last) = 206, part
                        extra.append(("Content-Range", f"bytes {first}-{last}/{st.st_size}"))
                self.start(code, ctype, last - first + 1, csp, extra)
                if self.command == "HEAD":
                    return
                left = last - first + 1
                try:
                    f.seek(first)
                    while left > 0:
                        data = f.read(min(CHUNK, left))
                        if not data:  # the file shrank: the promised length cannot be met, so end the connection
                            self.close_connection = True
                            break
                        self.wfile.write(data)
                        left -= len(data)
                except OSError:  # the client left, or stopped reading for `timeout` seconds
                    self.close_connection = True

    return FileHandler


class IdleStop(Exception):
    """The file server had no open connection for its --idle time."""


class FileServer(ThreadingHTTPServer):
    """The file share's server. With a listening socket from systemd (`sock`) it does not bind, counts open connections
    (counted where it accepts them) and stops after `idle` seconds without one."""
    daemon_threads = True

    def __init__(self, address, handler, sock=None, idle=None):
        self.idle_count, self.idle = IdleCount(), idle
        if sock is None:
            super().__init__(address, handler)
            return
        super().__init__(address, handler, bind_and_activate=False)
        self.socket.close()
        self.socket = sock
        self.server_address = sock.getsockname()[:2]
        self.server_name, self.server_port = self.server_address

    def process_request(self, request, client_address):
        self.idle_count.opened()
        try:
            super().process_request(request, client_address)
        except BaseException:
            self.idle_count.closed()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.idle_count.closed()

    def service_actions(self):  # in serve_forever's loop, between accepts
        if self.idle is not None and self.idle_count.idle_for() >= self.idle:
            raise IdleStop()


def cmd_serve_file(args):
    try:
        root = check_share_root(args.root)
    except FileShareRefused as e:
        print(f"preview: {e}", file=sys.stderr)
        return EXIT_CONFIG
    if args.port not in FILE_PORTS:
        print(f"preview: file shares use ports {FILE_PORTS.start}-{FILE_PORTS.stop - 1}, not {args.port}", file=sys.stderr)
        return EXIT_CONFIG
    host = check_listen_host("127.0.0.1")  # the file server is never reachable except through the preview proxy
    try:
        sock = inherited_socket()
        if sock is not None:
            check_inherited(sock, host, args.port)
    except (OSError, UnsafeListenAddress) as e:
        print(f"preview: cannot use the socket from systemd: {e}", file=sys.stderr)
        return EXIT_CONFIG
    idle = args.idle if sock is not None else None  # without systemd's socket nothing would start it again
    try:
        server = FileServer((host, args.port), make_file_handler(root), sock=sock, idle=idle)
    except OSError as e:
        print(f"preview: cannot listen on {host}:{args.port}: {e.strerror or e}", file=sys.stderr)
        return EXIT_CONFIG
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: threading.Thread(target=server.shutdown, daemon=True).start())
    print(f"preview: serving {root} read-only on {host}:{args.port}"
          + (f" (socket from systemd, stops after {idle:g} s idle)" if idle else ""), flush=True)
    sd_notify("READY=1")
    try:
        server.serve_forever()
    except IdleStop:
        print(f"preview: no connection for {idle:g} s; the socket starts this server again at the next one", flush=True)
    finally:
        server.server_close()
    return 0


# ---------------------------------------------------------------------------
# Cua desktops (`preview cua`): an index on 127.0.0.1:18500 (preview-cua-index.service, via `preview _cua-index`) lists
# the Spaces `cua spaces ls --json` knows, live at each request, and every `direct:<host>:<port>` Space gets its own
# owner-only proxy on 18501 and up. Tapping a Space mints a one-hour viewer link with `cua sandbox view` and redirects to
# that Space's share; the ticket travels only in that redirect's URL fragment and is never logged, printed or stored.
# ---------------------------------------------------------------------------

class CuaRefused(ValueError):
    pass


SPACE_ID = re.compile(r"direct:(\d{1,3}(?:\.\d{1,3}){3}|\[[0-9A-Fa-f:]+\]):(\d{1,5})")
PUBLIC_HOST = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?")
CUA_PAGE_CSP = "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
FRAGMENT_OK = re.compile(r"[A-Za-z0-9._~%!$&'()*+,;=:@/?-]+")


def space_address(space_id):
    """(host, port) of a `direct:<host>:<port>` Space a share may reach (loopback or tailnet only), else None."""
    m = SPACE_ID.fullmatch(space_id) if isinstance(space_id, str) else None
    if not m or not 1 <= int(m.group(2)) <= 65535:
        return None
    try:
        return check_listen_host(m.group(1)), int(m.group(2))
    except UnsafeListenAddress:
        return None


def space_upstream(host, port):
    return f"[{host}]:{port}" if ":" in host else f"{host}:{port}"


def parse_spaces(text):
    """([{id, name, host, upstream_port}], [skipped ids]) for the direct Spaces in `cua spaces ls --json`, or None."""
    try:
        data = json.loads(text)
    except (ValueError, TypeError):
        return None
    items = data.get("spaces") if isinstance(data, dict) else data
    if not isinstance(items, list):
        return None
    spaces, skipped, seen = [], [], set()
    for item in items:
        sid = item.get("id") if isinstance(item, dict) else None
        if not isinstance(sid, str) or not sid.startswith("direct:") or sid in seen:
            continue
        seen.add(sid)
        address = space_address(sid)
        if not address:
            skipped.append(printable(sid))
            continue
        name = next((item[k] for k in ("name", "display_name", "label", "title")
                     if isinstance(item.get(k), str) and printable(item[k]).strip()), sid)
        spaces.append({"id": sid, "name": printable(name).strip()[:80], "host": address[0], "upstream_port": address[1]})
    return spaces, skipped


def run_cua(argv, timeout=30):
    """(exit code, stdout) of one cua command; its output is never printed or logged."""
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return done.returncode, done.stdout


def _cua_page(status, title, body):
    headers = [("Content-Type", "text/html; charset=utf-8"), ("Cache-Control", "no-store"),
               ("Content-Security-Policy", CUA_PAGE_CSP), ("Referrer-Policy", "no-referrer"),
               ("X-Content-Type-Options", "nosniff")]
    return status, headers, html_page(title, body).encode()


def with_audio_off(fragment):
    """The viewer's fragment with audio=none (the desktop container has no working sound server)."""
    pairs = [pair for pair in fragment.split("&") if pair and pair.split("=", 1)[0] != "audio"]
    return "&".join(pairs + ["audio=none"])


def cua_index_answer(path, run, cua, public_host, shares):
    """(status, headers, body) for one GET on the index. shares: {Space id: its share port}."""
    path = path.split("?", 1)[0]

    def listed():
        code, out = run([cua, "spaces", "ls", "--json"])
        parsed = parse_spaces(out) if code == 0 else None
        return parsed[0] if parsed else None

    if path == "/":
        spaces = listed()
        if spaces is None:
            return _cua_page(502, "Cua desktops", "<h1>Cua desktops</h1><p>cua could not list the desktops on this "
                                                  "machine. Try again, or run <code>cua spaces ls</code> there.</p>")
        rows = []
        for space in spaces:
            name, port = html.escape(space["name"]), shares.get(space["id"])
            rows.append(f'<li><a href="/open/{port}">{name}</a></li>' if port else
                        f"<li>{name} <small>(not shared yet: run <code>preview cua</code> on the machine)</small></li>")
        body = ('<h1>Cua desktops</h1>\n<ul class="index">\n' + "\n".join(rows) + "\n</ul>\n"
                "<p><small>Tap a desktop to open it. Each tap makes a fresh link for one hour.</small></p>") if rows else \
            "<h1>Cua desktops</h1><p>No Cua desktops are registered on this machine (cua spaces ls).</p>"
        return _cua_page(200, "Cua desktops", body)
    found = re.fullmatch(r"/open/(\d{1,5})", path)
    sid = next((i for i, p in shares.items() if found and p == int(found.group(1))), None)
    if sid is None:
        return _cua_page(404, "Not found", '<p>Not found. <a href="/">All desktops</a></p>')
    spaces = listed()
    if spaces is None:
        return _cua_page(502, "Cua desktops", '<p>cua could not list the desktops. <a href="/">Try again</a></p>')
    if sid not in {space["id"] for space in spaces}:
        return _cua_page(404, "Not found", '<p>This desktop is no longer registered. <a href="/">All desktops</a></p>')
    code, out = run([cua, "sandbox", "view", sid, "--no-open", "--json", "--ttl", "1h"])
    try:
        url = json.loads(out).get("url") if code == 0 else None
        parts = urllib.parse.urlsplit(url) if isinstance(url, str) and not CONTROL_CHARS.search(url) else None
    except (ValueError, TypeError, AttributeError):
        parts = None
    if parts is None or parts.path != "/viewer/" or not FRAGMENT_OK.fullmatch(parts.fragment or ""):
        return _cua_page(502, "Cua desktops", '<p>cua could not open this desktop. <a href="/">Try again</a></p>')
    location = f"https://{public_host}:{shares[sid]}/viewer/#{with_audio_off(parts.fragment)}"
    return 303, [("Location", location), ("Cache-Control", "no-store"), ("Referrer-Policy", "no-referrer")], b""


def make_cua_index_handler(run, cua, public_host, shares):
    """GET/HEAD handler for the index; `shares` returns {Space id: share port} at each request. Logs nothing."""

    class IndexHandler(BaseHTTPRequestHandler):
        server_version = "preview"
        sys_version = ""

        def __getattr__(self, name):
            if name.startswith("do_"):
                return self.not_allowed
            raise AttributeError(name)

        def log_message(self, format, *args):
            pass

        def send_error(self, code, message=None, explain=None):
            self.reply(*_cua_page(code, "Error", f"<p>{int(code)}</p>"))

        def not_allowed(self):
            self.reply(405, [("Content-Type", "text/plain; charset=utf-8"), ("Allow", "GET, HEAD")],
                       b"Only GET and HEAD are allowed.\n")

        def reply(self, status, headers, body):
            self.send_response(status)
            for name, value in headers:
                self.send_header(name, value)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def do_GET(self):
            self.reply(*cua_index_answer(self.path, run, cua, public_host, shares()))

        do_HEAD = do_GET

    return IndexHandler


def cmd_cua_index(args):
    if not os.path.isabs(args.cua) or not os.access(args.cua, os.X_OK):
        print(f"preview: --cua must be the absolute path of the cua program, not {printable(args.cua)!r}", file=sys.stderr)
        return EXIT_CONFIG
    if args.port != CUA_PORT:
        print(f"preview: the Cua desktops index uses port {CUA_PORT}, not {args.port}", file=sys.stderr)
        return EXIT_CONFIG
    if not PUBLIC_HOST.fullmatch(args.public_host):
        print("preview: --public-host must be this machine's tailnet name", file=sys.stderr)
        return EXIT_CONFIG
    os.environ["PREVIEW_STATE_DIR"] = args.state_dir
    host = check_listen_host("127.0.0.1")  # reachable only through the owner-only preview proxy
    shares = lambda: {e["space_id"]: e["port"] for e in all_states() if cua_space_of(e)}
    try:
        server = ThreadingHTTPServer((host, args.port), make_cua_index_handler(run_cua, args.cua, args.public_host, shares))
    except OSError as e:
        print(f"preview: cannot listen on {host}:{args.port}: {e.strerror or e}", file=sys.stderr)
        return EXIT_CONFIG
    server.daemon_threads = True
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: threading.Thread(target=server.shutdown, daemon=True).start())
    print(f"preview: Cua desktops index on {host}:{args.port}", flush=True)
    try:
        server.serve_forever()
    finally:
        server.server_close()
    return 0


# ---------------------------------------------------------------------------
# Unit files (~/.config/systemd/user): every preview is an enabled unit, so it comes back after a reboot
# ---------------------------------------------------------------------------

UNIT_MARKER = "# Written by preview; `preview stop` disables and deletes this file."
UNIT_NAME = re.compile(r"preview-(?:\d{1,5}|file-\d{1,5})(?:\.service|\.socket)?|preview-cua-index(?:\.service)?")
_SYSTEMD_PLAIN = re.compile(r"[A-Za-z0-9_./:@,+=-]+")


def systemd_word(arg):
    """One ExecStart= argument, quoted so systemd passes it through unchanged ($$ and %% are a literal $ and %)."""
    if CONTROL_CHARS.search(arg):
        raise ValueError("refusing a unit command that contains control characters")
    if _SYSTEMD_PLAIN.fullmatch(arg):
        return arg
    return '"' + arg.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%").replace("$", "$$") + '"'


def unit_description(description):
    return printable(description).strip().rstrip("\\").strip().replace("%", "%%") or "preview"


def socket_of(unit):
    """The socket unit that starts a preview unit on demand: preview-5173 -> preview-5173.socket."""
    return (unit[:-len(".service")] if unit.endswith(".service") else unit) + ".socket"


def unit_file_text(description, argv, on_demand=False):
    """The unit file of one preview unit: the same command and restart rules the transient units had, plus [Install].
    On demand, its socket unit (socket_file_text) is what is enabled and starts it, so it has no [Install] of its own;
    it tells systemd when it is ready (Type=notify), so `systemctl start` fails when the server cannot come up."""
    ready = ["Type=notify", "TimeoutStartSec=30"] if on_demand else []
    install = [] if on_demand else ["[Install]", "WantedBy=default.target", ""]
    return "\n".join([
        UNIT_MARKER, "[Unit]", f"Description={unit_description(description)}", "StartLimitIntervalSec=0", "",
        "[Service]", *ready, "ExecStart=" + " ".join(systemd_word(arg) for arg in argv), "Restart=on-failure",
        "RestartSec=2", f"RestartPreventExitStatus={EXIT_CONFIG}", "Environment=PYTHONUNBUFFERED=1", "", *install])


def socket_file_text(description, listen):
    """The socket unit of an on-demand preview unit: it listens on `listen` (loopback or the tailnet IP only, the same
    guarantee as for any proxy) from boot on and starts the service of the same name at the first connection."""
    host, port = parse_hostport(listen)
    host = check_listen_host(host)
    lines = [UNIT_MARKER, "[Unit]", f"Description={unit_description(description)}", "",
             "[Socket]", "ListenStream=" + (f"[{host}]:{port}" if ":" in host else f"{host}:{port}"), "Accept=no"]
    if not ipaddress.ip_address(host).is_loopback:
        lines.append("FreeBind=yes")  # after a reboot the tailnet IP exists only once tailscaled is up
    return "\n".join(lines + ["", "[Install]", "WantedBy=sockets.target", ""])


# ---------------------------------------------------------------------------
# System access (tailscale, systemd --user, ss). Tests replace this class.
# ---------------------------------------------------------------------------

class TailnetUnknown(RuntimeError):
    """Tailscale did not report this machine's tailnet name and IP."""


READ_ONLY = (("tailscale", "status"), ("tailscale", "serve", "status"), ("tailscale", "debug", "prefs"), ("ss",),
             ("systemctl", "--user", "is-active"), ("systemctl", "--user", "list-units"))
PREFETCH_THREADS = 6


class System:
    def __init__(self):
        self._ts = None
        self._memo, self._memo_lock = {}, threading.Lock()  # answers of the read-only queries of this command

    def run(self, argv, timeout=30):
        """A read-only query (READ_ONLY) runs once per command, later calls get its answer; any other command may
        change what they say and clears them. Nothing polls through here: waiting loops use can_connect."""
        key = tuple(argv)
        read_only = any(key[:len(p)] == p for p in READ_ONLY)
        with self._memo_lock:
            if not read_only:
                self._memo.clear()
            elif key in self._memo:
                return self._memo[key]
        r = self._run(argv, timeout)
        if read_only:
            self._remember(argv, r)
        return r

    def _remember(self, argv, result):
        with self._memo_lock:
            self._memo[tuple(argv)] = result

    def _run(self, argv, timeout):
        try:
            return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        except FileNotFoundError:
            return subprocess.CompletedProcess(argv, 127, "", f"{argv[0]}: not found")
        except subprocess.TimeoutExpired:
            return subprocess.CompletedProcess(argv, 124, "", f"{argv[0]}: timed out")

    def prefetch(self, *queries):
        """Ask independent read-only queries (functions without arguments) at once, in at most PREFETCH_THREADS threads,
        and return when all have answered, so the calls after it are answered from the memo. Only read-only queries:
        nothing else runs meanwhile. An error is ignored here; the caller's own call meets it and reports it as before."""
        todo, lock = list(queries), threading.Lock()

        def worker():
            while True:
                with lock:
                    if not todo:
                        return
                    query = todo.pop()
                try:
                    query()
                except Exception:
                    pass

        threads = [threading.Thread(target=worker, daemon=True) for _ in range(min(len(todo), PREFETCH_THREADS))]
        for t in threads:
            t.start()
        for t in threads:
            t.join()

    def tailnet(self):
        """(tailnet IPv4, MagicDNS name) of this machine; TailnetUnknown when Tailscale cannot say (never a guess)."""
        if self._ts is None:
            r = self.run(["tailscale", "status", "--self", "--peers=false", "--json"], timeout=10)
            ip = name = None
            if r.returncode == 0:
                try:
                    me = json.loads(r.stdout)["Self"]
                    name = me.get("DNSName", "").rstrip(".") or None
                    ip = next((a for a in me.get("TailscaleIPs", []) if "." in a), None)
                except (ValueError, KeyError, TypeError, AttributeError):
                    pass
            if not (ip and name):
                raise TailnetUnknown("tailscale status gave no tailnet name and IP for this machine "
                                     "(is Tailscale running and logged in? check: tailscale status)")
            self._ts = (ip, name)
        return self._ts

    def owner_login(self):
        """The Tailscale login that owns this machine (Self.UserID -> User[id].LoginName), or None."""
        r = self.run(["tailscale", "status", "--json"], timeout=10)
        if r.returncode != 0:
            return None
        try:
            data = json.loads(r.stdout)
            login = data["User"][str(data["Self"]["UserID"])]["LoginName"]
        except (ValueError, KeyError, TypeError):
            return None
        return login if isinstance(login, str) and login.strip() == login and login and not CONTROL_CHARS.search(login) else None

    def cua_spaces(self, cua):
        """parse_spaces of `cua spaces ls --json`, or None when cua could not answer."""
        r = self.run([cua, "spaces", "ls", "--json"], timeout=30)
        return parse_spaces(r.stdout) if r.returncode == 0 else None

    def cua_path(self):
        """The cua program (also in ~/.local/bin, where Cua's installer puts it), as an absolute path, or None."""
        path = os.pathsep.join(p for p in (os.environ.get("PATH", ""), str(Path.home() / ".local/bin")) if p)
        found = shutil.which("cua", path=path)
        return os.path.abspath(found) if found else None

    def operator_ok(self):
        """True/False if we can tell whether this user may change Tailscale Serve, None if unknown."""
        if os.geteuid() == 0:
            return True
        r = self.run(["tailscale", "debug", "prefs"], timeout=10)
        if r.returncode != 0:
            return None
        try:
            op = json.loads(r.stdout).get("OperatorUser") or ""
        except ValueError:
            return None
        return op == current_user()

    def serve_ports(self):
        """Ports that have a Tailscale Serve entry (anyone's), or None when Tailscale could not say."""
        targets = self.serve_targets()
        return None if targets is None else set(targets)

    def serve_targets(self):
        """{port: where its Tailscale Serve entry leads ("http://127.0.0.1:<port>", "" for anything but a proxy at /)}
        for every entry (anyone's), or None when Tailscale could not say: never an empty guess."""
        r = self.run(["tailscale", "serve", "status", "--json"], timeout=10)
        if r.returncode != 0:
            return None
        try:
            config = json.loads(r.stdout or "{}")
            targets = {int(p): "" for p in (config.get("TCP") or {})}
            for host, web in (config.get("Web") or {}).items():
                port = int(host.rsplit(":", 1)[1])
                if port in targets:
                    targets[port] = ((web.get("Handlers") or {}).get("/") or {}).get("Proxy") or ""
            return targets
        except (ValueError, AttributeError, IndexError, TypeError):
            return None

    def serve_add(self, port, internal_port):
        r = self.run(["tailscale", "serve", "--bg", "--yes", f"--https={port}", f"http://127.0.0.1:{internal_port}"], timeout=30)
        return r.returncode == 0, (r.stderr or r.stdout).strip()

    def serve_remove(self, port):
        r = self.run(["tailscale", "serve", f"--https={port}", "off"], timeout=30)
        return r.returncode == 0, (r.stderr or r.stdout).strip()

    def unit_state(self, unit):
        r = self.run(["systemctl", "--user", "is-active", unit], timeout=10)
        return (r.stdout or "").strip() or "unknown"

    def unit_states(self, units):
        """{unit: state} for many units in one systemctl call: is-active prints one line per unit, in order; for more
        than 8 preview units list-units, which lists all of them at once (is-active with 334 names: 60 ms). Later
        unit_state calls for these units are answered from the memo."""
        units = list(dict.fromkeys(u for u in units if isinstance(u, str)))
        if not units:
            return {}
        states = self._listed_states(units) if len(units) > 8 else None
        if states is None:
            r = self.run(["systemctl", "--user", "is-active", *units], timeout=30)
            lines = (r.stdout or "").splitlines()
            if len(lines) != len(units):
                return {u: self.unit_state(u) for u in units}
            states = {u: line.strip() or "unknown" for u, line in zip(units, lines)}
        for unit, state in states.items():
            argv = ["systemctl", "--user", "is-active", unit]
            self._remember(argv, subprocess.CompletedProcess(argv, 0 if state == "active" else 3, state + "\n", ""))
        return states

    def _listed_states(self, units):
        """unit_states from one `systemctl --user list-units` of the preview units, or None when it cannot say (another
        unit, no JSON). A unit systemd has not loaded is not listed and is inactive, as is-active says."""
        if not all(u.startswith(UNIT_PREFIX) and (u.endswith((".service", ".socket")) or "." not in u) for u in units):
            return None
        r = self.run(["systemctl", "--user", "list-units", "--all", "-o", "json", UNIT_PREFIX + "*"], timeout=30)
        if r.returncode != 0:
            return None
        try:
            listed = {row["unit"]: row["active"] for row in json.loads(r.stdout)}
        except (ValueError, TypeError, KeyError):
            return None
        if not all(isinstance(state, str) and state for state in listed.values()):
            return None
        return {u: listed.get(u if "." in u else u + ".service", "inactive") for u in units}

    def unit_dir(self):
        """Where the systemd user manager reads unit files (it does not see this shell's XDG_CONFIG_HOME)."""
        return Path.home() / ".config" / "systemd" / "user"

    def unit_path(self, unit):
        return self.unit_dir() / (unit if unit.endswith((".service", ".socket")) else unit + ".service")

    def has_unit_file(self, unit):
        """True when the unit is a regular file this tool wrote (its first line is UNIT_MARKER)."""
        if not isinstance(unit, str) or not UNIT_NAME.fullmatch(unit):
            return False
        path = self.unit_path(unit)
        try:
            if path.is_symlink() or not path.is_file():
                return False
            with open(path, encoding="utf-8", errors="replace") as f:
                return f.readline().rstrip("\n") == UNIT_MARKER
        except OSError:
            return False

    def own_unit_files(self):
        """Sorted names of the unit files this tool wrote that are still in the unit folder (recorded or not)."""
        try:
            names = [p.name for p in self.unit_dir().iterdir() if UNIT_NAME.fullmatch(p.name)]
        except OSError:
            return []
        return sorted(name for name in names if self.has_unit_file(name))

    def unit_comes_back(self, unit):
        """True when a unit file this tool wrote brings `unit` back after a reboot: its socket unit (on demand), or its
        own [Install] section."""
        if not self.has_unit_file(unit):
            return False
        if not unit.endswith(".socket") and self.has_unit_file(socket_of(unit)):
            return True
        try:
            return "\n[Install]\n" in self.unit_path(unit).read_text(encoding="utf-8", errors="replace")
        except OSError:
            return False

    def unit_start(self, unit, description, argv, listen=None):
        """Write the unit file, enable and start it, so the preview comes back after a reboot. A unit an older version
        started with systemd-run (transient) is stopped first; the file then takes its place with the same command.
        With `listen` (HOST:PORT) the unit starts on demand: its socket unit preview-….socket listens there, enabled,
        and starts the service (not enabled itself) at a connection. The service is started once here as well, so a
        server that cannot come up fails now. Without `listen`, a socket this tool wrote for the unit is removed."""
        if not UNIT_NAME.fullmatch(unit):
            return False, f"refusing to manage {printable(unit)!r}: not a preview unit"
        sock = socket_of(unit)
        try:
            files = {unit: unit_file_text(description, argv, on_demand=listen is not None)}
            if listen is not None:
                files[sock] = socket_file_text(description, listen)
        except ValueError as e:
            return False, str(e)
        for name in files:
            path = self.unit_path(name)
            if (path.exists() or path.is_symlink()) and not self.has_unit_file(name):
                return False, f"{path} exists and was not written by preview; remove or rename it"
        old_socket = self.has_unit_file(sock)
        with_socket = listen is not None or old_socket
        if with_socket:
            self.run(["systemctl", "--user", "stop", sock], timeout=20)  # first: it would start the service again
        self.run(["systemctl", "--user", "stop", unit], timeout=20)
        if listen is not None:  # a plain unit file of an earlier release was enabled itself; on demand only its socket is
            self.run(["systemctl", "--user", "disable", unit], timeout=20)
        elif old_socket:
            self.run(["systemctl", "--user", "disable", sock], timeout=20)
        for name in ([sock] if with_socket else []) + [unit]:
            self.run(["systemctl", "--user", "reset-failed", name], timeout=10)
        path = self.unit_path(unit)
        try:
            for name, text in files.items():
                path = self.unit_path(name)
                path.parent.mkdir(parents=True, exist_ok=True)
                tmp = path.with_name(f".{path.name}.tmp")
                tmp.write_text(text)
                tmp.chmod(0o644)
                tmp.replace(path)
            if listen is None and old_socket:
                path = self.unit_path(sock)
                path.unlink(missing_ok=True)
        except OSError as e:
            return False, f"cannot write {path}: {e.strerror or e}"
        self.run(["systemctl", "--user", "daemon-reload"], timeout=30)
        steps = [("enable", sock), ("start", sock), ("start", unit)] if listen is not None else [("enable", unit), ("start", unit)]
        why = ""
        for verb, name in steps:
            r = self.run(["systemctl", "--user", verb, name], timeout=45 if verb == "start" else 30)
            if r.returncode != 0:
                why = (r.stderr or r.stdout).strip() or f"systemctl --user {verb} {name} failed"
                break
        else:
            for name in files:
                r = self.run(["systemctl", "--user", "show", "-p", "FragmentPath", "--value", name], timeout=10)
                loaded = (r.stdout or "").strip()
                if not loaded or os.path.realpath(loaded) != os.path.realpath(self.unit_path(name)):
                    why = f"systemd runs {name} from {printable(loaded) or 'no file'}, not from {self.unit_path(name)}"
                    break
        if why:
            self.unit_stop(unit)  # no half-made unit stays enabled
            return False, why
        return True, ""

    def unit_stop(self, unit):
        """Stop a preview unit, and first the socket that would start it again; for the unit files this tool wrote, also
        disable and delete them (nothing else)."""
        names = [unit]
        if not unit.endswith(".socket") and UNIT_NAME.fullmatch(socket_of(unit)):
            names.insert(0, socket_of(unit))
        ours = [name for name in names if self.has_unit_file(name)]
        for name in ours:
            self.run(["systemctl", "--user", "disable", name], timeout=20)
        for name in names:
            self.run(["systemctl", "--user", "stop", name], timeout=20)
            self.run(["systemctl", "--user", "reset-failed", name], timeout=10)
        for name in ours:
            try:
                self.unit_path(name).unlink()
            except FileNotFoundError:
                pass
        if ours:
            self.run(["systemctl", "--user", "daemon-reload"], timeout=30)

    def unit_log(self, unit, lines=5):
        r = self.run(["journalctl", "--user", "-u", unit, "-n", str(lines), "--no-pager", "-o", "cat"], timeout=10)
        return (r.stdout or "").strip()

    def listen_addresses(self, port):
        """Addresses of the TCP listeners on a port. Without process names: ss -p reads every process (~40 ms)."""
        return [addr for addr, _ in self._listening(["ss", "-Hltn", f"sport = :{port}"])]

    def listeners(self, port):
        """[(address, process)] of TCP listeners on a port."""
        return self._listening(["ss", "-Hltnp", f"sport = :{port}"])

    def _listening(self, argv):
        r = self.run(argv, timeout=10)
        out = []
        for line in (r.stdout or "").splitlines():
            cols = line.split()
            if len(cols) < 4:
                continue
            addr = cols[3].rsplit(":", 1)[0].strip("[]").split("%")[0]
            m = re.search(r'users:\(\("([^"]+)"', line)
            out.append((addr, m.group(1) if m else ""))
        return out

    def can_connect(self, host, port, timeout=0.5):
        try:
            with socket.create_connection((host, port), timeout=timeout):
                return True
        except OSError:
            return False

    def free_local_port(self, avoid=()):
        """A free loopback port for a proxy, never one of SHARE_PORTS (a file share or Cua desktop needs it later) or of
        `avoid` (the ports of recorded previews, whose dev server may be down just now). The ports turned down stay
        bound until one fits, so the kernel offers another each time."""
        held = []
        try:
            while len(held) < 100:
                s = socket.socket()
                held.append(s)
                s.bind(("127.0.0.1", 0))
                port = s.getsockname()[1]
                if port not in SHARE_PORTS and port not in avoid:
                    return port
            raise OSError(f"no free loopback port outside {SHARE_PORTS.start}-{SHARE_PORTS.stop - 1}")
        finally:
            for s in held:
                s.close()

    def can_bind(self, port):
        """A socket can listen on 127.0.0.1:<port> now. Without SO_REUSEADDR, so a port that a connection holds as its
        source port, open or in TIME_WAIT, counts as taken: ss -l does not show it, but systemd's socket cannot bind it."""
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", port))
                s.listen()
                return True
            except OSError:
                return False

    def sleep(self, seconds):
        time.sleep(seconds)

    def firewall_tailnet_ports(self, path="/etc/nftables.conf"):
        """Ports the host firewall lets in from the tailnet, or None if it does not restrict them (or is unreadable).

        Tailscale Serve is not affected: tailscaled accepts those connections itself, before this firewall."""
        try:
            text = Path(path).read_text()
        except OSError:
            return None
        if "policy drop" not in text or re.search(r'iifname "tailscale0"\s+accept', text):
            return None
        ports = set()
        for m in re.finditer(r'iifname "tailscale0"[^\n]*?tcp dport (\{[^}]*\}|\d+)[^\n]*accept', text):
            ports.update(int(x) for x in re.findall(r"\d+", m.group(1)))
        return ports


def current_user():
    try:
        import pwd
        return pwd.getpwuid(os.geteuid()).pw_name
    except (ImportError, KeyError):
        return os.environ.get("USER", "")


# ---------------------------------------------------------------------------
# State (one JSON file per preview; only these previews are ever stopped)
# ---------------------------------------------------------------------------

def state_dir():
    return Path(os.environ.get("PREVIEW_STATE_DIR") or Path.home() / ".local/state/preview")


def load_state(port):
    try:
        return json.loads((state_dir() / f"{port}.json").read_text())
    except (OSError, ValueError):
        return None


@contextlib.contextmanager
def state_lock(d):
    """The state folder's lock: the proxies write opened_at into the same files this command writes."""
    with open(Path(d) / ".lock", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


class Busy(RuntimeError):
    """Another preview command kept the flow lock too long."""


FLOW_WAIT = 60  # seconds a command waits for another one that creates or stops previews
_flow = threading.local()


@contextlib.contextmanager
def flow_lock():
    """One create or stop at a time (preview <port>, file, cua, stop, restore), from reading the records to the last
    write, so two agents never act on the same port or record in between. Held again in the same thread (preview file
    runs preview <port>) without waiting; the proxies' opened_at writes keep their own short .lock."""
    if getattr(_flow, "held", False):
        yield
        return
    d = state_dir()
    d.mkdir(parents=True, exist_ok=True)
    with open(d / ".flow.lock", "a") as f:
        deadline = time.monotonic() + FLOW_WAIT
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise Busy(f"another preview command has been creating or stopping previews for {FLOW_WAIT} s; "
                               f"try again")
                time.sleep(0.1)
        _flow.held = True
        try:
            yield
        finally:
            _flow.held = False


def one_flow(command):
    @functools.wraps(command)
    def run(*args, **kwargs):
        with flow_lock():
            return command(*args, **kwargs)
    return run


def unix_time(value):
    return value if isinstance(value, int) and not isinstance(value, bool) and value > 0 else None


def save_state(entry):
    d = state_dir()
    d.mkdir(parents=True, exist_ok=True)
    path = d / f"{entry['port']}.json"
    with state_lock(d):
        try:  # what a proxy recorded since this command read the file: the latest open, the first time it was observed
            disk = json.loads(path.read_text())
        except (OSError, ValueError):
            disk = None
        if isinstance(disk, dict):
            for name, pick in (("opened_at", max), ("observed_since", min)):
                values = [v for v in (unix_time(entry.get(name)), unix_time(disk.get(name))) if v]
                if values:
                    entry[name] = pick(values)
        tmp = d / f".{entry['port']}.json.tmp"
        tmp.write_text(json.dumps(entry, indent=2) + "\n")
        tmp.replace(path)


def drop_state(port):
    d = state_dir()
    try:
        with state_lock(d):
            (d / f"{port}.json").unlink()
    except FileNotFoundError:
        pass


def record_opened(path, listen, when):
    """Set opened_at in a preview's state file (run by its proxy). Only an existing record whose listen address is this
    proxy's, and never back in time; atomic (temporary file, then rename). False when nothing was written."""
    path = Path(path)
    try:
        with state_lock(path.parent):
            entry = json.loads(path.read_text())
            if not isinstance(entry, dict) or entry.get("listen") != listen or (unix_time(entry.get("opened_at")) or 0) >= when:
                return False
            entry["opened_at"] = when
            tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
            tmp.write_text(json.dumps(entry, indent=2) + "\n")
            tmp.replace(path)
            return True
    except (OSError, ValueError):
        return False


def all_states():
    d = state_dir()
    out = []
    for f in sorted(d.glob("*.json"), key=lambda p: int(p.stem) if p.stem.isdigit() else 0) if d.exists() else []:
        try:
            out.append(json.loads(f.read_text()))
        except (OSError, ValueError):
            pass
    return out


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def self_path():
    return os.path.realpath(__file__)


def links(sysm, port):
    _, name = sysm.tailnet()
    return f"https://{name}:{port}", f"http://{name}:{port}"


UP = ("active", "idle", "activating")  # unit_status of an on-demand unit that serves (running, asleep, starting)


def on_demand_ok(entry):
    """Every preview starts on demand except the Cua desktops shares, which keep running all the time."""
    return entry.get("kind") not in ("cua", "cua-space")


def unit_status(sysm, unit, states=None):
    """'active' (running), 'idle' (on demand and asleep: its socket listens and starts it at the next connection), or
    systemd's word for anything else ('failed', 'inactive', ...); when its socket does not listen, 'socket <state>'.
    `states` (from unit_states) saves the systemctl calls."""
    get = lambda name: (states or {}).get(name) or sysm.unit_state(name)
    state = get(unit)
    if not sysm.has_unit_file(socket_of(unit)):
        return state
    sock = get(socket_of(unit))
    if sock != "active":
        return f"socket {sock}"
    return "idle" if state in ("inactive", "deactivating") else state


def server_up(sysm, unit, host, port, states=None):
    """A preview unit's server is there: running and listening, or (on demand) asleep behind its listening socket. An
    on-demand unit gets no test connection: it would start the server, and the socket accepts it even when the server
    cannot start."""
    if sysm.has_unit_file(socket_of(unit)):
        return unit_status(sysm, unit, states) in UP
    return sysm.unit_state(unit) == "active" and sysm.can_connect(host, port, timeout=0.5)


def target_listening(sysm, port, states=None):
    """Something answers on localhost:<port>. For a file share whose server starts on demand, systemd says so instead
    (see server_up)."""
    file_unit = f"{FILE_UNIT_PREFIX}{port}.service"
    if port in FILE_PORTS and sysm.has_unit_file(socket_of(file_unit)):
        return unit_status(sysm, file_unit, states) in UP
    return sysm.can_connect("127.0.0.1", port) or sysm.can_connect("::1", port)


def wildcard_or_public(addr, ts_ip):
    if addr in ("*", "0.0.0.0", "::"):
        return True
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return False
    return not (ip.is_loopback or any(ip in n for n in TAILNET_NETS) or ip.is_link_local)


def guess_label(sysm, port):
    for addr, proc in sysm.listeners(port):
        if proc and addr in ("127.0.0.1", "::1"):
            return proc
    return f"port {port}"


def wait_listening(sysm, host, port, seconds=4.0):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if sysm.can_connect(host, port, timeout=0.3):
            return True
        sysm.sleep(0.15)
    return False


def proxy_argv(sysm, entry, on_demand=False):
    """The proxy command for a recorded preview (on demand: it stops when idle); a Cua share always keeps its owner gate
    (ValueError when it cannot)."""
    argv = ["/usr/bin/python3", "-I", self_path(), "_serve", "--listen", entry["listen"],
            "--target", str(entry["port"]), "--public-url", entry["link"], "--tailnet-ip", sysm.tailnet()[0]]
    if cua_unit_of(entry):
        argv += ["--upstream-host", "127.0.0.1", "--upstream-port", str(CUA_PORT), "--owner-login", entry["owner_login"]]
    elif cua_space_of(entry):
        space_host, space_port = space_address(entry["space_id"])
        argv += ["--upstream-host", space_host, "--upstream-port", str(space_port), "--owner-login", entry["owner_login"]]
    elif entry.get("kind") in ("cua", "cua-space"):
        raise ValueError("its Cua share record is incomplete, so it would start without the owner gate; "
                         "run preview cua again")
    return argv + (IDLE_ARGS if on_demand else [])


def start_unit(sysm, entry):
    unit = entry["unit"]
    host, lport = parse_hostport(entry["listen"])
    on_demand = on_demand_ok(entry)
    try:
        argv = proxy_argv(sysm, entry, on_demand)
    except ValueError as e:
        return False, str(e)
    ok, err = sysm.unit_start(unit, f"preview {entry['port']}: {entry['label']}", argv,
                              listen=entry["listen"] if on_demand else None)
    if not ok:
        return False, err or "systemd-run failed"
    if not wait_listening(sysm, host, lport):
        log = sysm.unit_log(unit)
        sysm.unit_stop(unit)
        return False, log or f"proxy did not start listening on {entry['listen']}"
    return True, ""


def serve_state(entry, targets):
    """Where an HTTPS preview's Tailscale Serve entry leads: "ok" (to its proxy), "missing", "elsewhere", or "unknown"
    (`targets` None: Tailscale could not say); None for an HTTP preview, which has no entry."""
    if entry.get("backend") != "https":
        return None
    if targets is None:
        return "unknown"
    if entry["port"] not in targets:
        return "missing"
    return "ok" if targets[entry["port"]].rstrip("/") == f"http://{entry['listen']}" else "elsewhere"


def entry_healthy(sysm, entry):
    """No create or stop left its record half done (status), its proxy serves (running, or asleep behind its socket),
    and an HTTPS preview's Tailscale Serve entry leads to that proxy."""
    if entry.get("status"):
        return False
    host, lport = parse_hostport(entry["listen"])
    if not server_up(sysm, entry["unit"], host, lport):
        return False
    return serve_state(entry, sysm.serve_targets() if entry["backend"] == "https" else None) in (None, "ok")


def note_for(entry, listening, sysm=None):
    port = entry["port"]
    parts = []
    if entry["backend"] == "https":
        parts.append(f"HTTPS via Tailscale Serve to localhost:{port}, tailnet devices only.")
    else:
        parts.append(f"HTTP to localhost:{port}, tailnet devices only. HTTP until Tailscale Serve is enabled (preview doctor).")
        allowed = sysm.firewall_tailnet_ports() if sysm else None
        if allowed is not None and port not in allowed:
            parts.append(f"Warning: the VPS firewall only lets tailnet traffic reach ports {', '.join(map(str, sorted(allowed))) or 'none'}, "
                         f"so this HTTP link will not load. Fix: enable Tailscale Serve (preview doctor), then run preview {port} again.")
    if not listening:
        parts.append(f"Nothing listens on localhost:{port} yet; the page waits for it.")
    parts.append(f"Stop: preview stop {port}")
    return "  " + " ".join(parts)


def created_by():
    """The herdr session and agent this command runs in, or None when neither is known."""
    found = {key: printable(os.environ.get(var, "")).strip()[:80] or None
             for key, var in (("session", "HERDR_SESSION"), ("agent", "CONDUCTOR_AGENT"))}
    return found if any(found.values()) else None


def owner_key():
    """Who `stop --all` treats as the caller: the herdr pane (one agent, subagents inherit it), prefixed by its herdr
    session. None when the pane is unknown."""
    pane = printable(os.environ.get("HERDR_PANE_ID", "")).strip()[:80]
    if not pane:
        return None
    session = printable(os.environ.get("HERDR_SESSION", "")).strip()[:80]
    return f"{session}/{pane}" if session else pane


def tracking(existing, now):
    """created_by, observed_since (and opened_at) of a new record. A preview made again on its port keeps its record's:
    the same link, the same preview."""
    if existing is None:
        return {"created_by": created_by(), "owner": owner_key(), "observed_since": now}
    out = {"created_by": existing.get("created_by"), "owner": existing.get("owner"),
           "observed_since": unix_time(existing.get("observed_since")) or now}
    if unix_time(existing.get("opened_at")):
        out["opened_at"] = existing["opened_at"]
    return out


SERVE_UNKNOWN = ("tailscale serve status did not answer, so preview cannot tell which ports Tailscale Serve uses; "
                 "nothing changed. Try again once it answers")
SHARE_FIELDS = ("path", "kind", "file_unit", "behalten")  # a file share's; rebuilding its proxy keeps them


def serve_left(port, why):
    return printable(f"preview: Tailscale could not remove the Serve entry of port {port} ({why or 'no reason given'}); "
                     f"its record stays, and preview stop {port} removes both once Tailscale answers")


def backend_choice(operator, forced):
    """'https' when cmd_start tries Tailscale Serve first, 'http' when it goes straight to the tailnet-IP proxy."""
    return "https" if forced != "http" and (operator is not False or forced == "https") else "http"


def ask_ahead(sysm, port, existing, guess_label_too=False):
    """The read-only queries a run for this port asks, all at once (System.prefetch)."""
    names = [n for u in entry_units(existing) if isinstance(u, str) for n in (u, socket_of(u))] if existing else []
    sysm.prefetch(sysm.tailnet, sysm.serve_ports, sysm.operator_ok,
                  *([lambda: sysm.listen_addresses(port)] if port is not None else []),
                  *([lambda: sysm.unit_states(names)] if names else []),
                  *([lambda: sysm.listeners(port)] if guess_label_too else []))


@one_flow
def cmd_start(sysm, port, label=None, out=None, err=None, cua=None, share=None):
    """`cua` is set only by cmd_cua: the Cua share's fields (owner login, viewer unit); it is HTTPS or nothing. `share`
    only by cmd_file: the file share's SHARE_FIELDS, in its record from the first write on."""
    out, err = out or sys.stdout, err or sys.stderr
    existing = load_state(port)
    ask_ahead(sysm, port, existing, guess_label_too=not (label or (existing or {}).get("label")))
    ts_ip, _ = sysm.tailnet()
    https_link, http_link = links(sysm, port)
    if cua is None and existing and existing.get("kind") in ("cua", "cua-space"):
        print(f"preview: port {port} is the Cua desktops share; run preview cua again, or preview stop cua first", file=err)
        return 1

    exposed = [a for a in sysm.listen_addresses(port) if wildcard_or_public(a, ts_ip)]
    if exposed:
        print(f"preview: something on this VPS already listens on {exposed[0]}:{port}, which includes the public "
              f"internet. Restart the dev server bound to 127.0.0.1 (for example --host 127.0.0.1), then run "
              f"preview {port} again.", file=err)
        return 1
    serve = sysm.serve_ports()
    if serve is None:
        print(f"preview: {SERVE_UNKNOWN}", file=err)
        return 1
    others_serve = serve - ({port} if existing and existing.get("backend") == "https" else set())
    if port in others_serve:
        print(f"preview: Tailscale Serve already uses port {port} for something else; pick another port.", file=err)
        return 1

    label = label or (existing or {}).get("label") or guess_label(sysm, port)
    operator = sysm.operator_ok()
    forced = os.environ.get("PREVIEW_BACKEND", "")

    same_share = cua is None or all(existing and existing.get(k) == v for k, v in cua.items())
    if existing and same_share and entry_healthy(sysm, existing):
        upgrade = existing["backend"] == "http" and operator is True and forced != "http"
        if not upgrade:
            changed = label != existing.get("label") or any(existing.get(k) != v for k, v in (share or {}).items())
            existing.update(label=label, **(share or {}))
            if not existing.get("persistent"):  # an older version's transient unit: same port, listen and link, as a file
                started, msg = start_unit(sysm, existing)
                if not started:
                    print(f"preview: could not keep port {port} across a reboot: {msg}", file=err)
                    return 1
                existing["persistent"] = changed = True
            if changed:
                save_state(existing)
            print(existing["link"], file=out)
            print(note_for(existing, target_listening(sysm, port), sysm), file=err)
            return 0
    if existing:
        stopped, why = stop_entry(sysm, existing, quiet=True)
        if not stopped:
            print(serve_left(port, why), file=err)
            return 1

    entry = None
    serve_error = ""
    now = int(time.time())
    kept = {k: existing[k] for k in SHARE_FIELDS if k in existing} if existing else {}  # a file share stays one
    if backend_choice(operator, forced) == "https":
        internal = sysm.free_local_port(avoid={e.get("port") for e in all_states()})
        entry = {"port": port, "label": label, "backend": "https", "link": https_link,
                 "listen": f"127.0.0.1:{internal}", "unit": f"{UNIT_PREFIX}{port}", "created": now,
                 **tracking(existing, now), **kept, **(share or {}), **(cua or {}), "status": "creating"}
        save_state(entry)  # before any effect: what a run that ends early set up, the next run or stop removes
        ok, serve_error = sysm.serve_add(port, internal)
        if ok:
            started, msg = start_unit(sysm, entry)
            if not started:
                print(f"preview: could not start the proxy for port {port}: {msg}", file=err)
                stopped, why = stop_entry(sysm, entry)
                if not stopped:
                    print(serve_left(port, why), file=err)
                return 1
            entry["persistent"] = True
        else:
            drop_state(port)
            entry = None
    if entry is None:
        if cua is not None:  # the login gate only holds behind Tailscale Serve; never fall back to HTTP for this share
            print(f"preview: the Cua desktops link needs HTTPS through Tailscale Serve, which is not available here "
                  f"({serve_error or 'not permitted'}); see preview doctor", file=err)
            return 1
        if forced == "https":
            print(f"preview: Tailscale Serve is not available: {serve_error or 'not permitted'}", file=err)
            return 1
        entry = {"port": port, "label": label, "backend": "http", "link": http_link,
                 "listen": f"{ts_ip}:{port}", "unit": f"{UNIT_PREFIX}{port}", "created": now, **tracking(existing, now),
                 **kept, **(share or {}), "status": "creating"}
        save_state(entry)
        started, msg = start_unit(sysm, entry)
        if not started:
            drop_state(port)
            print(f"preview: could not start the proxy for port {port}: {msg}", file=err)
            return 1
        entry["persistent"] = True
    del entry["status"]
    save_state(entry)
    print(entry["link"], file=out)
    print(note_for(entry, target_listening(sysm, port), sysm), file=err)
    return 0


def stop_entry(sysm, entry, quiet=False):
    """Remove an HTTPS preview's Tailscale Serve entry, stop its proxy, drop its record: (True, ""). When Tailscale
    cannot remove the entry, nothing else changes: (False, why). The record says "stopping" meanwhile, so a stop that
    ends early is finished by the next run or stop."""
    before = entry.get("status")
    entry["status"] = "stopping"
    save_state(entry)
    if entry.get("backend") == "https":
        ok, why = sysm.serve_remove(entry["port"])
        left = None if ok else sysm.serve_ports()
        if not ok and (left is None or entry["port"] in left):  # an entry that is gone already is fine
            entry.pop("status")
            if before:
                entry["status"] = before
            save_state(entry)
            return False, why
    sysm.unit_stop(entry["unit"])
    drop_state(entry["port"])
    return True, ""


def file_unit_of(entry):
    """The file-server unit of a file share (only the name this tool gives it, whatever the state file says)."""
    unit = f"{FILE_UNIT_PREFIX}{entry['port']}.service"
    return unit if entry.get("file_unit") == unit else None


def cua_unit_of(entry):
    """The index unit of the Cua desktops share (only the name this tool gives it, whatever the state file says)."""
    ok = entry.get("kind") == "cua" and entry.get("cua_unit") == CUA_UNIT and entry.get("port") == CUA_PORT
    return CUA_UNIT if ok else None


def cua_space_of(entry):
    """True for one Cua desktop's share whose recorded upstream is the address in its Space id."""
    address = space_address(entry.get("space_id"))
    return bool(entry.get("kind") == "cua-space" and entry.get("port") in CUA_SPACE_PORTS and address
                and entry.get("upstream") == space_upstream(*address) and entry.get("owner_login"))


def legacy_cua_key():
    return state_dir() / "cua" / "viewer.key"


def stop_legacy_viewer(sysm, out):
    """Stop the Cua viewer an earlier release ran (preview-cua-viewer.service on 127.0.0.1:18500, transient, so only a
    reboot would end it) and delete its key file. True when there was one; nothing else is touched."""
    running = sysm.unit_state(LEGACY_CUA_UNIT) in ("active", "activating", "deactivating", "reloading", "failed")
    if running:
        sysm.unit_stop(LEGACY_CUA_UNIT)
    key = legacy_cua_key()
    had_key = key.is_file() or key.is_symlink()
    if had_key:
        try:
            key.unlink()
            key.parent.rmdir()  # only when empty; the current release keeps nothing there
        except OSError:
            pass
    if running or had_key:
        print(f"stopped {LEGACY_CUA_UNIT} (the Cua viewer of an earlier release) and removed its key file", file=out)
    return running or had_key


def stop_share(sysm, entry):
    """Stop a preview, and for a file share also its file server, for the Cua desktops index also its server; (ok, why)
    of stop_entry, and when it failed nothing is stopped."""
    ok, why = stop_entry(sysm, entry)
    if ok and file_unit_of(entry):
        sysm.unit_stop(file_unit_of(entry))
    if ok and cua_unit_of(entry):
        sysm.unit_stop(CUA_UNIT)
    return ok, why


def stop_and_say(sysm, entry, out, err):
    ok, why = stop_share(sysm, entry)
    print(stopped_line(entry) if ok else serve_left(entry["port"], why), file=out if ok else err)
    return ok


def stopped_line(entry):
    return printable(f"stopped {entry['port']} ({entry['label']}" + (f", {entry['path']})" if entry.get("path") else ")"))


@one_flow
def cmd_stop(sysm, port=None, all_=False, out=None, err=None, path=None, cua=False, everyone=False):
    out, err = out or sys.stdout, err or sys.stderr
    if cua:
        legacy = stop_legacy_viewer(sysm, out)
        index = load_state(CUA_PORT)
        entries = ([index] if index and cua_unit_of(index) else []) + [e for e in all_states() if cua_space_of(e)]
        if not entries:
            if sysm.unit_state(CUA_UNIT) == "active" or sysm.has_unit_file(CUA_UNIT):  # an index left without its link
                sysm.unit_stop(CUA_UNIT)
            if legacy:
                return 0
            print("preview: no Cua desktops share running (see preview list)", file=err)
            return 1
        failed = [entry for entry in entries if not stop_and_say(sysm, entry, out, err)]
        return 1 if failed else 0
    if all_ and not everyone:
        key = owner_key()
        if key is None:
            print("preview: cannot tell which session this is (HERDR_PANE_ID is not set), so --all would not know "
                  "which previews are yours. Stop one by port, or use: preview stop --all --everyone", file=err)
            return 1
        everything = all_states()
        entries = [e for e in everything if e.get("owner") == key]
        failed = [e for e in entries if not stop_and_say(sysm, e, out, err)]
        skipped = len(everything) - len(entries)
        if not entries:
            print("no previews of this session running", file=out)
        if skipped:
            print(f"kept {skipped} preview{'s' if skipped != 1 else ''} of other sessions or from before sessions were "
                  f"recorded; preview stop --all --everyone stops those too", file=out)
        return 1 if failed else 0
    if all_:
        legacy = stop_legacy_viewer(sysm, out)
        entries = all_states()
        failed = [e for e in entries if not stop_and_say(sysm, e, out, err)]
        kept = {name.removesuffix(".service") for e in failed for u in entry_units(e) if isinstance(u, str)
                for name in (u, socket_of(u))}  # a preview whose stop failed still runs, and its record names them
        own = lambda: [u for u in sysm.own_unit_files() if u.removesuffix(".service") not in kept]
        orphans = own()  # written by this tool, but their record is gone: they would come back at boot
        for unit in orphans:
            sysm.unit_stop(unit)
            print(printable(f"stopped {unit} (no preview recorded it)"), file=out)
        if not entries and not orphans and not legacy:
            print("no previews running", file=out)
        left = own()
        if left:
            print(printable(f"preview: could not remove {', '.join(left)}; they would start again after a reboot. "
                            f"Check: systemctl --user status {left[0]}"), file=err)
            return 1
        return 1 if failed else 0
    if path is not None:
        wanted = {os.path.abspath(os.path.expanduser(path))}
        try:
            wanted.add(str(Path(os.path.expanduser(path)).resolve()))
        except (OSError, RuntimeError):
            pass
        entry = next((e for e in all_states() if e.get("path") in wanted), None)
        if not entry:
            print(f"preview: no file share for {path} (see preview list)", file=err)
            return 1
    else:
        entry = load_state(port)
        if not entry:
            print(f"preview: no preview on port {port} (see preview list)", file=err)
            return 1
    return 0 if stop_and_say(sysm, entry, out, err) else 1


def free_share_port(sysm, ports, taken):
    """The first of `ports` that is not taken, has no listener and can be bound now (F8: a connection's port can not)."""
    return next((p for p in ports if p not in taken and not sysm.listen_addresses(p) and not target_listening(sysm, p)
                 and sysm.can_bind(p)), None)


def pick_file_port(sysm):
    serve = sysm.serve_ports()
    if serve is None:
        raise FileShareRefused(SERVE_UNKNOWN)
    return free_share_port(sysm, FILE_PORTS, {e.get("port") for e in all_states()} | serve)


def plan_file_share(sysm, path, label=None):
    """What `preview file <path>` will do, without starting anything."""
    root = check_share_root(path)
    existing = next((e for e in all_states() if e.get("path") == str(root)), None)
    ask_ahead(sysm, existing["port"] if existing else None, existing)
    port = existing["port"] if existing else pick_file_port(sysm)
    ends = oldest_share() if port is None else None
    if port is None and ends is None:
        raise FileShareRefused(f"no free port in {FILE_PORTS.start}-{FILE_PORTS.stop - 1} for file shares; "
                               f"stop one first (preview list). Shares pinned with --behalten are never ended to make room")
    port = ends["port"] if ends else port
    operator, forced = sysm.operator_ok(), os.environ.get("PREVIEW_BACKEND", "")
    backend = backend_choice(operator, forced)
    if existing and entry_healthy(sysm, existing):
        upgrade = existing["backend"] == "http" and operator is True and forced != "http"
        backend = backend if upgrade else existing["backend"]
    label = label or (existing or {}).get("label") or (root.name + ("/" if root.is_dir() else ""))
    return {"path": str(root), "kind": "folder" if root.is_dir() else "file", "port": port, "label": label,
            "serve": ("127.0.0.1", port), "unit": f"{FILE_UNIT_PREFIX}{port}.service", "proxy_unit": f"{UNIT_PREFIX}{port}",
            "backend": backend, "reuse": existing is not None, "persistent": bool(existing and existing.get("persistent")),
            "argv": file_server_argv(root, port), "ends": ends}


def oldest_share():
    """The file share a new one ends when all FILE_PORTS are taken: the oldest by `created`; never one pinned with
    --behalten, one a create or stop left half done (status), or a preview that is not a file share."""
    shares = [e for e in all_states() if e.get("port") in FILE_PORTS and file_unit_of(e) and e.get("path")
              and e.get("behalten") is not True and not e.get("status")]
    return min(shares, key=lambda e: unix_time(e.get("created")) or 0, default=None)


def file_server_argv(root, port):
    return ["/usr/bin/python3", "-I", self_path(), "_serve-file", "--root", str(root), "--port", str(port)]


def file_plan(argv, sysm):
    """The plan for a `file ...` command line (port, loopback bind, backend), with nothing started."""
    cmd, a = parse(argv)
    if cmd != "file":
        raise ValueError("file_plan takes a `file <path>` command line")
    return plan_file_share(sysm, a.path, a.name)


@one_flow
def cmd_file(sysm, path, label=None, out=None, err=None, keep=False):
    out, err = out or sys.stdout, err or sys.stderr
    try:
        plan = plan_file_share(sysm, path, label)
    except FileShareRefused as e:
        print(f"preview: {e}", file=err)
        return 1
    port, unit = plan["port"], plan["unit"]
    host, lport = plan["serve"]
    old = plan["ends"]
    if old:  # every port is taken: end the oldest share as preview stop does, and take its port
        ok, why = stop_share(sysm, old)
        if not ok:
            print(serve_left(old["port"], why), file=err)
            return 1
        print(printable(f"  Ended the oldest file share to free its port: {old['port']} ({old['label']}, {old['path']}). "
                        f"Pin a share to keep it: preview file <path> --behalten"), file=err)
    if not (plan["persistent"] and server_up(sysm, unit, host, lport)):
        ok, msg = sysm.unit_start(unit, f"preview file {port}: {plan['label']}", plan["argv"] + IDLE_ARGS,
                                  listen=f"{host}:{lport}")
        if ok and not wait_listening(sysm, host, lport):
            ok, msg = False, sysm.unit_log(unit) or f"file server did not start listening on {host}:{lport}"
        if not ok:
            sysm.unit_stop(unit)
            print(f"preview: could not start the file server for {plan['path']}: {msg or 'systemd-run failed'}", file=err)
            return 1
    code = cmd_start(sysm, port, plan["label"], out=out, err=err,
                     share={"path": plan["path"], "kind": plan["kind"], "file_unit": unit,
                            **({"behalten": True} if keep else {})})
    if code != 0:
        if (load_state(port) or {}).get("file_unit") != unit:  # a record that names it keeps it for its next stop
            sysm.unit_stop(unit)
        return code
    print(f"  Shares {plan['path']} read-only. Stop: preview stop {shlex.quote(plan['path'])}", file=err)
    return 0


def cmd_list(sysm, as_json=False, out=None):
    out = out or sys.stdout
    entries = all_states()
    names = [name for e in entries for u in entry_units(e) if isinstance(u, str) for name in (u, socket_of(u))]
    states = sysm.unit_states(names)  # one systemctl call; no test connection to a server that starts on demand
    targets = sysm.serve_targets() if any(e.get("backend") == "https" for e in entries) else None
    rows = []
    for e in entries:
        row = {**e, "target_listening": target_listening(sysm, e["port"], states),
               "proxy": unit_status(sysm, e["unit"], states), "serve": serve_state(e, targets)}
        for name in ("opened_at", "observed_since"):
            row[name] = unix_time(e.get(name))
        row["created_by"] = e.get("created_by") if isinstance(e.get("created_by"), dict) else None
        if file_unit_of(e):
            row["file_server"] = unit_status(sysm, file_unit_of(e), states)
            row["behalten"] = e.get("behalten") is True
        if cua_unit_of(e):
            row["index"] = unit_status(sysm, CUA_UNIT, states)
        rows.append(row)
    if as_json:
        print(json.dumps(rows, indent=2), file=out)
        return 0
    if not rows:
        print("no previews running (start one with: preview <port>)", file=out)
        return 0
    table = [("PORT", "LABEL", "BACKEND", "TARGET", "PROXY", "LINK", "PATH")]
    for r in rows:
        table.append((str(r["port"]), printable(r["label"]), r["backend"],
                      "listening" if r["target_listening"] else "not listening", r["proxy"], r["link"],
                      printable((r.get("path") or "") + (" (behalten)" if r.get("behalten") else "")
                                or (f"index {r['index']}" if "index" in r else "")
                                or (f"space {r['space_id']}" if cua_space_of(r) else ""))))
    widths = [max(len(row[i]) for row in table) for i in range(len(table[0]))]
    for row in table:
        print("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip(), file=out)
    return 0


def cmd_doctor(sysm, out=None):
    out = out or sys.stdout
    try:
        ts_ip, name = sysm.tailnet()
    except TailnetUnknown as e:
        ts_ip, name = "unknown", f"unknown ({e})"
    operator = sysm.operator_ok()
    user = current_user()
    print(f"tailnet name   {name}", file=out)
    print(f"tailnet IP     {ts_ip}", file=out)
    if operator is True:
        print("backend        https (Tailscale Serve is allowed for this user)", file=out)
        print(f"links look like https://{name}:<port>", file=out)
        stale = [e["port"] for e in all_states() if e.get("backend") == "http"]
        if stale:
            print(f"upgrade        these previews are still HTTP; run preview <port> again: {', '.join(map(str, stale))}", file=out)
    else:
        why = "not allowed for this user" if operator is False else "could not check"
        print(f"backend        http (Tailscale Serve {why}; links look like http://{name}:<port>)", file=out)
        print("enable HTTPS   run once on the VPS as an admin (needs sudo):", file=out)
        print(f"                 sudo tailscale set --operator={user}", file=out)
        print("               then run preview <port> again for each open preview; it switches to https://", file=out)
    allowed = sysm.firewall_tailnet_ports()
    if allowed is not None:
        print(f"firewall       tailnet traffic to the VPS itself is limited to ports {', '.join(map(str, sorted(allowed)))};", file=out)
        print("               the HTTP backend only works on those ports, HTTPS via Tailscale Serve works on any port", file=out)
    r = sysm.run(["systemctl", "--user", "is-system-running"], timeout=10)
    print(f"systemd --user {(r.stdout or r.stderr).strip() or 'unknown'}", file=out)
    linger = sysm.run(["loginctl", "show-user", user, "-p", "Linger", "--value"], timeout=10).stdout.strip()
    print(f"linger         {linger or 'unknown'} (yes = previews keep running after logout)", file=out)
    print(f"previews       {len(all_states())} open (preview list)", file=out)
    broken_line(sysm, out)
    persistence_line(sysm, out)
    on_demand_line(sysm, out)
    login, share = sysm.owner_login(), load_state(CUA_PORT)
    if not sysm.cua_path():
        print("cua desktops   cua is not installed, so preview cua cannot run (install Cua, check cua --version)", file=out)
    elif not login or login == "tagged-devices":
        print("cua desktops   preview cua cannot tell which Tailscale login owns this machine (tailscale status --json)",
              file=out)
    elif operator is False:
        print("cua desktops   preview cua needs the https backend (enable HTTPS above)", file=out)
    else:
        running = "running" if share and cua_unit_of(share) else "not running"
        print(f"cua desktops   preview cua gives {printable(login)} one link to every Cua desktop ({running})", file=out)
    return 0


def broken_line(sysm, out):
    """doctor: previews whose Tailscale Serve entry does not lead to their proxy, or whose create or stop did not finish."""
    entries = all_states()
    targets = sysm.serve_targets() if any(e.get("backend") == "https" for e in entries) else {}
    if targets is None:
        print(f"serve entries  unknown ({SERVE_UNKNOWN.split(',')[0]})", file=out)
        return
    broken = [f"{e['port']} ({e['status'] if e.get('status') else 'serve ' + serve_state(e, targets)})" for e in entries
              if e.get("status") or serve_state(e, targets) not in (None, "ok")]
    if broken:
        print(printable(f"broken         {', '.join(broken)}; fix: preview <port> again for each, or preview stop <port>"),
              file=out)


def entry_units(entry):
    """Every unit a recorded preview runs: its proxy, plus the file server or the Cua desktops index."""
    return [entry.get("unit")] + [u for u in (file_unit_of(entry), cua_unit_of(entry)) if u]


def transient_previews(sysm):
    """Recorded previews with a unit that would not come back after a reboot (an older version started it with
    systemd-run, or an on-demand unit lost its socket)."""
    return [e for e in all_states() if not all(isinstance(u, str) and sysm.unit_comes_back(u) for u in entry_units(e))]


def persistence_line(sysm, out):
    transient = transient_previews(sysm)
    if transient:
        ports = ", ".join(printable(e.get("port")) for e in transient)
        print(f"persistent     no ({ports} would not come back after a reboot); fix: preview restore", file=out)
    else:
        print("persistent     yes (every preview comes back after a reboot)", file=out)


def sleeps(sysm, entry):
    """True when every unit of a recorded preview starts on demand (has its socket unit)."""
    return all(isinstance(u, str) and sysm.has_unit_file(socket_of(u)) for u in entry_units(entry))


def on_demand_line(sysm, out):
    entries = [e for e in all_states() if on_demand_ok(e)]
    if not entries:
        return
    asleep = sum(1 for e in entries if sleeps(sysm, e))
    rest = len(entries) - asleep
    print(f"on demand      {asleep} of {len(entries)} previews start at the first request and stop after "
          f"{IDLE_SECONDS // 60} idle minutes" + (f"; {rest} run all the time (fix: preview restore)" if rest else ""),
          file=out)


def unit_specs(sysm, entry):
    """[{unit, description, argv, listen, wait: (host, port), seconds}] to rebuild a recorded preview's units, file server
    or index first. `argv` runs the unit all the time; with `listen`, it may start on demand instead (argv + IDLE_ARGS
    behind a socket on `listen`). ValueError (or KeyError, TypeError) when the record cannot be trusted to rebuild them."""
    port = entry["port"]
    if not isinstance(port, int) or entry["unit"] != f"{UNIT_PREFIX}{port}":
        raise ValueError("its record does not name its own unit")
    host, lport = parse_hostport(entry["listen"])
    check_listen_host(host)
    label = entry.get("label") or f"port {port}"
    on_demand = on_demand_ok(entry)
    specs = []
    if file_unit_of(entry):
        root = check_share_root(entry["path"])
        if str(root) != entry["path"]:
            raise ValueError(f"{entry['path']} now resolves to {root}; run preview file again")
        specs.append({"unit": file_unit_of(entry), "description": f"preview file {port}: {label}",
                      "argv": file_server_argv(root, port), "listen": f"127.0.0.1:{port}" if on_demand else None,
                      "wait": ("127.0.0.1", port), "seconds": 4.0})
    if cua_unit_of(entry):
        cua = sysm.cua_path()
        if not cua:
            raise ValueError("cua is not installed (install it from github.com/trycua/cua, then check cua --version)")
        specs.append({"unit": CUA_UNIT, "description": "preview cua: Cua desktops index", "argv": cua_index_argv(sysm, cua),
                      "listen": None, "wait": ("127.0.0.1", CUA_PORT), "seconds": 20.0})
    specs.append({"unit": entry["unit"], "description": f"preview {port}: {label}", "argv": proxy_argv(sysm, entry),
                  "listen": entry["listen"] if on_demand else None, "wait": (host, lport), "seconds": 4.0})
    return specs


def units_to_restore(sysm, entry):
    """The units of a recorded preview that restore (re)writes: those that would not come back after a reboot, and
    those that could start on demand but still run all the time. Cua desktops shares only ever get the first."""
    todo = []
    for unit in entry_units(entry):
        if not isinstance(unit, str) or not sysm.unit_comes_back(unit):
            todo.append(unit)
        elif on_demand_ok(entry) and unit != CUA_UNIT and not sysm.has_unit_file(socket_of(unit)):
            todo.append(unit)
    return todo


def start_spec(sysm, spec, on_demand):
    unit, (host, lport) = spec["unit"], spec["wait"]
    argv = spec["argv"] + (IDLE_ARGS if on_demand else [])
    ok, msg = sysm.unit_start(unit, spec["description"], argv, listen=spec["listen"] if on_demand else None)
    if ok and not (wait_up(sysm, host, lport, spec["seconds"]) if unit == CUA_UNIT
                   else wait_listening(sysm, host, lport, spec["seconds"])):
        ok, msg = False, sysm.unit_log(unit) or f"it did not come up on {host}:{lport}"
    return ok, msg


@one_flow
def cmd_restore(sysm, out=None, err=None, port=None):
    """Give every recorded preview (or the one on `port`) unit files that bring it back after a reboot, and let it start
    on demand (all but the Cua desktops shares): stop the old unit, write, enable, start. A unit that cannot start on
    demand runs all the time as before. Ports and links stay as recorded; the Tailscale Serve entries are kept by
    tailscaled and not touched. Only the units recorded in this tool's state are touched; safe to run again."""
    out, err = out or sys.stdout, err or sys.stderr
    entries = all_states()
    if port is not None:
        entries = [e for e in entries if e.get("port") == port]
        if not entries:
            print(f"preview: no preview on port {port} (see preview list)", file=err)
            return 1
    if port is None or port == CUA_PORT:
        stop_legacy_viewer(sysm, out)  # it would hold the index port that the Cua share comes back on
    restored, failed = 0, 0
    for entry in entries:
        todo = units_to_restore(sysm, entry)
        if not todo:
            continue
        what = printable(f"{entry.get('port')} ({entry.get('label')})")
        try:
            specs = unit_specs(sysm, entry)
        except (KeyError, TypeError, ValueError) as e:
            print(f"preview: could not restore {what}: {printable(e)}", file=err)
            failed += 1
            continue
        plain = []  # (unit, why) of units that could not start on demand and run all the time as before
        for spec in specs:
            if spec["unit"] not in todo:
                continue
            ok, msg = start_spec(sysm, spec, on_demand=spec["listen"] is not None)
            if not ok and spec["listen"] is not None:
                why = msg
                ok, msg = start_spec(sysm, spec, on_demand=False)
                if ok:
                    plain.append((spec["unit"], why))
            if not ok:
                sysm.unit_stop(spec["unit"])
                print(f"preview: could not restore {what}: {spec['unit']}: {printable(msg) or 'systemctl failed'}", file=err)
                failed += 1
                break
        else:
            entry["persistent"] = True
            entry.setdefault("observed_since", int(time.time()))  # its proxy now records when a person opens it
            save_state(entry)
            restored += 1
            for unit, why in plain:
                print(f"preview: {what}: {unit} could not start on demand ({printable(why) or 'systemctl failed'}); "
                      f"it runs all the time as before", file=err)
            failed += bool(plain)
            how = "starts at the first request, " if on_demand_ok(entry) and not plain else ""
            print(f"restored {what}: {how}comes back after a reboot, link {entry['link']}", file=out)
    if not restored and not failed:
        print("nothing to restore: every preview already comes back after a reboot", file=out)
    return 1 if failed else 0


def wait_up(sysm, host, port, seconds=20.0):
    """True once something listens on host:port (counted in sleeps, so a stand-in clock never spins)."""
    for _ in range(int(seconds / 0.25)):
        if sysm.can_connect(host, port, timeout=0.3):
            return True
        sysm.sleep(0.25)
    return False


def cua_plan(sysm, label=None):
    """What `preview cua` will do, without starting anything; CuaRefused when it must not run."""
    login = sysm.owner_login()
    if not login:
        raise CuaRefused("cannot tell which Tailscale login owns this machine (tailscale status --json); "
                         "is Tailscale up?")
    if login == "tagged-devices":
        raise CuaRefused("this machine is a tagged Tailscale device, so no single login owns it; "
                         "the Cua desktops link is only for an owner")
    if backend_choice(sysm.operator_ok(), os.environ.get("PREVIEW_BACKEND", "")) != "https":
        raise CuaRefused("the Cua desktops link needs HTTPS through Tailscale Serve (over the http backend any "
                         "tailnet member could pass for the owner); see preview doctor")
    cua = sysm.cua_path()
    if not cua:
        raise CuaRefused("cua is not installed (install it from github.com/trycua/cua, then check cua --version)")
    existing = load_state(CUA_PORT)
    if existing and not cua_unit_of(existing):
        raise CuaRefused(f"port {CUA_PORT} already has another preview; run preview stop {CUA_PORT} first")
    listed = sysm.cua_spaces(cua)
    if listed is None:
        raise CuaRefused("cua could not list the desktops on this machine (cua spaces ls --json)")
    found, skipped = listed
    states = all_states()
    known = {e["space_id"]: e for e in states if cua_space_of(e)}
    ids = {space["id"] for space in found}
    stale = [e for sid, e in known.items() if sid not in ids]
    stale_ports = {e["port"] for e in stale}
    serve = sysm.serve_ports()
    if serve is None:
        raise CuaRefused(SERVE_UNKNOWN)
    taken = ({e.get("port") for e in states} | serve) - stale_ports
    spaces, unplaced = [], []
    for space in found:
        port = known[space["id"]]["port"] if space["id"] in known else free_share_port(sysm, CUA_SPACE_PORTS, taken)
        if port is None:
            unplaced.append(space["name"])
            continue
        taken.add(port)
        spaces.append({**space, "port": port})
    return {"port": CUA_PORT, "label": label or (existing or {}).get("label") or CUA_LABEL,
            "serve": ("127.0.0.1", CUA_PORT), "unit": CUA_UNIT, "proxy_unit": f"{UNIT_PREFIX}{CUA_PORT}",
            "backend": "https", "owner_login": login, "cua": cua, "spaces": spaces, "stale": stale,
            "skipped": skipped, "unplaced": unplaced, "persistent": bool(existing and existing.get("persistent")),
            "argv": cua_index_argv(sysm, cua)}


def cua_index_argv(sysm, cua):
    return ["/usr/bin/python3", "-I", self_path(), "_cua-index", "--port", str(CUA_PORT), "--cua", cua,
            "--public-host", sysm.tailnet()[1], "--state-dir", str(state_dir())]


@one_flow
def cmd_cua(sysm, label=None, out=None, err=None):
    out, err = out or sys.stdout, err or sys.stderr
    stop_legacy_viewer(sysm, err)  # it holds 127.0.0.1:18500 until a reboot; stdout stays the one link
    try:
        plan = cua_plan(sysm, label)
    except CuaRefused as e:
        print(f"preview: {e}", file=err)
        return 1
    host, lport = plan["serve"]
    active = sysm.unit_state(CUA_UNIT) == "active"
    if not (plan["persistent"] and active and sysm.can_connect(host, lport)):
        if not active and (sysm.listen_addresses(lport) or target_listening(sysm, lport)):
            print(f"preview: something else already listens on port {lport}; stop it, then run preview cua again", file=err)
            return 1
        ok, msg = sysm.unit_start(CUA_UNIT, "preview cua: Cua desktops index", plan["argv"])
        if ok and not wait_up(sysm, host, lport):
            ok, msg = False, f"it did not come up on {host}:{lport} (journalctl --user -u {CUA_UNIT})"
        if not ok:
            sysm.unit_stop(CUA_UNIT)
            print(f"preview: could not start the Cua desktops index: {printable(msg or 'systemd-run failed')}", file=err)
            return 1
    login = plan["owner_login"]
    code = cmd_start(sysm, CUA_PORT, plan["label"], out=out, err=err,
                     cua={"kind": "cua", "cua_unit": CUA_UNIT, "owner_login": login})
    if code != 0:
        sysm.unit_stop(CUA_UNIT)
        return code
    failed = []
    for entry in plan["stale"]:  # Spaces cua no longer lists
        ok, why = stop_share(sysm, entry)
        if not ok:
            failed.append(serve_left(entry["port"], why).removeprefix("preview: "))
    for space in plan["spaces"]:
        quiet_out, why = io.StringIO(), io.StringIO()
        share = {"kind": "cua-space", "space_id": space["id"], "space_name": space["name"],
                 "upstream": space_upstream(space["host"], space["upstream_port"]), "owner_login": login}
        if cmd_start(sysm, space["port"], space["name"], out=quiet_out, err=why, cua=share) != 0:
            failed.append(f"{space['name']}: {printable(why.getvalue().strip()) or 'its proxy did not start'}")
    names = ", ".join(space["name"] for space in plan["spaces"]) or "none registered yet (cua spaces ls)"
    print(f"  Cua desktops: {names}. Open the link and tap one; each tap makes a fresh one-hour viewer link.", file=err)
    for sid in plan["skipped"]:
        print(f"  Skipped {sid}: a share only reaches loopback or tailnet addresses.", file=err)
    for name in plan["unplaced"]:
        print(f"  Skipped {name}: no free port in {CUA_SPACE_PORTS.start}-{CUA_SPACE_PORTS.stop - 1}.", file=err)
    for line in failed:
        print(f"preview: {line}", file=err)
    print(f"  Only {printable(login)} can open these links; anyone else gets 403. Stop: preview stop cua", file=err)
    return 1 if failed else 0


