class UnsafeListenAddress(ValueError):
    pass


def check_listen_host(host):
    """Allow only loopback or a Tailscale address. Never 0.0.0.0, ::, a hostname or a public IP."""
    try:
        ip = ipaddress.ip_address(host.strip("[]"))
    except ValueError:
        raise UnsafeListenAddress(f"refusing to listen on {host!r}: not a literal IP address")
    if ip.is_unspecified:
        raise UnsafeListenAddress(f"refusing to listen on {host}: that is every interface, including the public one")
    if ip.is_loopback or any(ip in net for net in TAILNET_NETS):
        return str(ip)
    raise UnsafeListenAddress(f"refusing to listen on {host}: only 127.0.0.1 or the Tailscale IP are allowed")


def parse_hostport(value):
    m = re.fullmatch(r"\[?([0-9a-fA-F:.]+)\]?:(\d+)", value)
    if not m:
        raise ValueError(f"expected HOST:PORT, got {value!r}")
    return m.group(1), int(m.group(2))


def check_port(value):
    try:
        port = int(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError(f"not a port number: {value!r}")
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError(f"port out of range (1-65535): {port}")
    if port in RESERVED_PORTS:
        raise argparse.ArgumentTypeError(f"port {port} is used by system services on this VPS; pick another port")
    return port


