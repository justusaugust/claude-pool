def html_page(title, body):
    return ('<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
            '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
            '<meta name="referrer" content="no-referrer">\n'
            f"<title>{html.escape(title)}</title>\n<style>{PAGE_CSS}</style>\n</head>\n<body>\n<main>\n"
            f"{body}\n</main>\n</body>\n</html>\n")


# Markdown: a small, conservative subset. Every text run is HTML-escaped; raw HTML shows as text;
# link and image URLs must be http(s), mailto (links only) or relative, otherwise only their text is kept.

MD_SPAN = 2000   # an inline construct (emphasis, link) may span at most this many characters
MD_DEPTH = 8     # nesting limit for block quotes, lists and emphasis
_MD_FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
_MD_HEADING = re.compile(r"^ {0,3}(#{1,6})(?:[ \t]+(.*))?$")
_MD_HR = re.compile(r"^ {0,3}([-*_])(?:[ \t]*\1){2,}[ \t]*$")
_MD_ITEM = re.compile(r"^( *)(?:([-*+])|(\d{1,9})[.)])(?:[ \t]+(.*))?$")
_MD_QUOTE = re.compile(r"^ {0,3}> ?(.*)$")
_MD_SPECIAL = re.compile(r"[\\`*_\[!<]")
_MD_LABEL = re.compile(r"\[((?:[^\[\]\\]|\\.|\[[^\[\]]*\])*)\]\(", re.S)
_MD_AUTOLINK = re.compile(r"<((?:https?|mailto):[^\s<>]+)>", re.I)
_MD_SPACE = " \t\n\r\f\v"
_ASCII_ALNUM = set("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")
# Every Markdown pattern above is linear: no two adjacent quantifiers can match the same characters. Closing
# delimiters for emphasis and code spans are found by bisecting precomputed positions, not by lazy regex scans.
_MD_ESCAPABLE = set("\\`*_{}[]()#+-.!|<>~\"'")


def md_url_ok(url, image=False):
    if not url or "\\" in url or any(ord(c) < 0x21 or ord(c) == 0x7F for c in url):
        return False
    m = re.match(r"([A-Za-z][A-Za-z0-9+.-]*):", url)
    if not m:
        return True  # relative
    return m.group(1).lower() in ({"http", "https"} if image else {"http", "https", "mailto"})


def _md_heading_text(text):
    """Heading text without an optional closing run of # (which must follow a space)."""
    text = (text or "").rstrip(" \t")
    bare = text.rstrip("#")
    if bare != text and (not bare or bare[-1] in " \t"):
        text = bare.rstrip(" \t")
    return text


def _md_table_sep(line):
    cells = line.strip()
    if "|" not in cells:
        return False
    cells = cells[1:] if cells.startswith("|") else cells
    cells = cells[:-1] if cells.endswith("|") else cells
    return all(re.fullmatch(r":?-+:?", cell.strip()) for cell in cells.split("|"))


def _md_destination(text, j, end):
    """Parse `url` or `<url>`, an optional "title" and the closing `)`, starting just after `(`.
    Returns (url, title, index after the `)`) or None. One pass, no backtracking."""
    while j < end and text[j] in _MD_SPACE:
        j += 1
    if j < end and text[j] == "<":
        k = text.find(">", j + 1, end)
        if k < 0 or "<" in text[j + 1:k] or "\n" in text[j + 1:k]:
            return None
        url, j = text[j + 1:k], k + 1
    else:
        start, nested = j, False
        while j < end and text[j] not in _MD_SPACE:
            c = text[j]
            if c in "<>":
                return None
            if c == "(":
                if nested:
                    return None
                nested = True
            elif c == ")":
                if not nested:
                    break
                nested = False
            j += 1
        if nested:
            return None
        url = text[start:j]
    k, title = j, None
    while k < end and text[k] in _MD_SPACE:
        k += 1
    if k > j and k < end and text[k] == '"':
        q = text.find('"', k + 1, end)
        if q < 0 or "\n" in text[k + 1:q]:
            return None
        title, k = text[k + 1:q], q + 1
        while k < end and text[k] in _MD_SPACE:
            k += 1
    if k < end and text[k] == ")":
        return url, title, k + 1
    return None


def md_inline(text, links=True, depth=0):
    if depth > MD_DEPTH:
        return html.escape(text)
    out, i, n = [], 0, len(text)
    marks = {}

    def closer(kind, lo, hi):
        """First closing delimiter of `kind` at a position in [lo, hi], or None."""
        if not marks:
            marks.update({"**": [], "__": [], "*": [], "_": [], "`": {}})
            for m in re.finditer(r"[*_]", text):
                j, c = m.start(), text[m.start()]
                if j == 0 or text[j - 1].isspace():
                    continue
                if text.startswith(c * 2, j):
                    marks[c * 2].append(j)
                if c == "*" and text[j - 1] != "*":
                    marks["*"].append(j)
                if c == "_" and not (j + 1 < n and text[j + 1] in _ASCII_ALNUM):
                    marks["_"].append(j)
            for m in re.finditer(r"`+", text):
                marks["`"].setdefault(m.end() - m.start(), []).append(m.start())
        found = marks[kind[0]].get(len(kind), []) if kind[0] == "`" else marks[kind]
        k = bisect.bisect_left(found, lo)
        return found[k] if k < len(found) and found[k] <= hi else None
    while i < n:
        m = _MD_SPECIAL.search(text, i)
        if not m:
            out.append(html.escape(text[i:]))
            break
        if m.start() > i:
            out.append(html.escape(text[i:m.start()]))
        i = m.start()
        c, end = text[i], min(n, i + MD_SPAN)
        if c == "\\" and i + 1 < n and text[i + 1] in _MD_ESCAPABLE:
            out.append(html.escape(text[i + 1]))
            i += 2
            continue
        if c == "`":
            j = i
            while j < n and text[j] == "`":
                j += 1
            run = j - i
            close = closer("`" * run, j, min(n, j + MD_SPAN) - run)
            if close is not None:
                out.append("<code>" + html.escape(text[j:close].strip(" ") or text[j:close]) + "</code>")
                i = close + run
            else:
                out.append(html.escape(text[i:j]))
                i = j
            continue
        if c == "!" and i + 1 < n and text[i + 1] == "[":
            lm = _MD_LABEL.match(text, i + 1, end)
            dest = lm and _md_destination(text, lm.end(), end)
            if dest:
                label, (url, title, after) = lm.group(1), dest
                if md_url_ok(url, image=True):
                    out.append(f'<img src="{html.escape(url)}" alt="{html.escape(label)}"'
                               + (f' title="{html.escape(title)}"' if title else "") + ">")
                else:
                    out.append(html.escape(label))
                i = after
                continue
        if c == "[":
            lm = _MD_LABEL.match(text, i, end)
            dest = lm and _md_destination(text, lm.end(), end)
            if dest:
                label, (url, title, after) = lm.group(1), dest
                inner = md_inline(label, links=False, depth=depth + 1)
                if links and md_url_ok(url):
                    out.append(f'<a href="{html.escape(url)}"' + (f' title="{html.escape(title)}"' if title else "")
                               + f">{inner}</a>")
                else:
                    out.append(inner)
                i = after
                continue
        if c == "<":
            am = _MD_AUTOLINK.match(text, i, end)
            if am and links and md_url_ok(am.group(1)):
                out.append(f'<a href="{html.escape(am.group(1))}">{html.escape(am.group(1))}</a>')
                i = am.end()
                continue
        if c in "*_" and not (c == "_" and i > 0 and text[i - 1].isalnum()):
            if text.startswith(c * 2, i) and i + 2 < n and not text[i + 2].isspace():
                j = closer(c * 2, i + 3, end - 2)
                if j is not None:
                    out.append("<strong>" + md_inline(text[i + 2:j], links, depth + 1) + "</strong>")
                    i = j + 2
                    continue
            if i + 1 < n and not text[i + 1].isspace() and not (c == "*" and text[i + 1] == "*"):
                j = closer(c, i + 2, end - 1)
                if j is not None:
                    out.append("<em>" + md_inline(text[i + 1:j], links, depth + 1) + "</em>")
                    i = j + 1
                    continue
        out.append(html.escape(c))
        i += 1
    return "".join(out)


def _md_table_cells(line):
    line = line.strip()
    if line.startswith("|"):
        line = line[1:]
    if line.endswith("|") and not line.endswith("\\|"):
        line = line[:-1]
    return [cell.strip() for cell in re.split(r"(?<!\\)\|", line)]


def _md_block_start(line):
    return bool(_MD_FENCE.match(line) or _MD_HEADING.match(line) or _MD_HR.match(line) or _MD_QUOTE.match(line))


def _md_list(lines, i, depth):
    """Parse the list that starts at lines[i]. Returns (html, next index)."""
    items, n = [], len(lines)
    while i < n:
        line = lines[i]
        if not line.strip():
            j = i
            while j < n and not lines[j].strip():
                j += 1
            if j < n and (_MD_ITEM.match(lines[j]) or lines[j].startswith("  ")):
                i = j
                continue
            break
        m = _MD_ITEM.match(line)
        if m and not _MD_HR.match(line):
            items.append({"indent": len(m.group(1)), "ordered": m.group(3) is not None,
                          "start": int(m.group(3) or 1), "text": [m.group(4) or ""]})
        elif items and (line.startswith("  ") or not _md_block_start(line)):
            items[-1]["text"].append(line.strip())
        else:
            break
        i += 1
    return _md_list_html(items, 0, depth)[0], i


def _md_list_html(items, k, depth):
    first = items[k]
    indent, ordered = first["indent"], first["ordered"]
    tag = "ol" if ordered else "ul"
    start = f' start="{first["start"]}"' if ordered and first["start"] != 1 else ""
    parts, current = [f"<{tag}{start}>"], None

    def close():
        if current is not None:
            parts.append("<li>" + md_inline("\n".join(current["text"]).strip(), depth=depth)
                         + "".join(current["children"]) + "</li>")

    while k < len(items):
        item = items[k]
        if item["indent"] < indent:
            break
        if item["indent"] >= indent + 2 and current is not None:
            if depth >= MD_DEPTH:
                current["text"].append(item["text"][0])
                current["text"].extend(item["text"][1:])
                k += 1
                continue
            child, k = _md_list_html(items, k, depth + 1)
            current["children"].append(child)
            continue
        if item["ordered"] != ordered:
            break
        close()
        current = {"text": list(item["text"]), "children": []}
        k += 1
    close()
    parts.append(f"</{tag}>")
    return "".join(parts), k


def md_blocks(raw_lines, depth=0):
    lines = [line.expandtabs(4) for line in raw_lines]
    out, para, i, n = [], [], 0, len(lines)

    def flush():
        if para:
            out.append("<p>" + md_inline("\n".join(p.strip() for p in para), depth=depth) + "</p>")
            para.clear()

    while i < n:
        line = lines[i]
        if not line.strip():
            flush()
            i += 1
            continue
        m = _MD_FENCE.match(line)
        if m and not (m.group(1)[0] == "`" and "`" in m.group(2)):
            flush()
            fence, info = m.group(1), m.group(2).strip()
            closing = re.compile(r"^ {0,3}" + re.escape(fence[0]) + "{%d,}[ \t]*$" % len(fence))
            i += 1
            code = []
            while i < n and not closing.match(lines[i]):
                code.append(raw_lines[i])
                i += 1
            i += 1
            lang = re.sub(r"[^\w+.-]", "", info.split()[0]) if info else ""
            cls = f' class="language-{lang}"' if lang else ""
            out.append(f"<pre><code{cls}>" + html.escape("\n".join(code)) + "</code></pre>")
            continue
        m = _MD_HEADING.match(line)
        if m:
            flush()
            level = len(m.group(1))
            out.append(f"<h{level}>" + md_inline(_md_heading_text(m.group(2)), depth=depth) + f"</h{level}>")
            i += 1
            continue
        if _MD_HR.match(line):
            flush()
            out.append("<hr>")
            i += 1
            continue
        if _MD_QUOTE.match(line):
            flush()
            quoted = []
            while i < n and _MD_QUOTE.match(lines[i]):
                quoted.append(_MD_QUOTE.match(lines[i]).group(1))
                i += 1
            if depth >= MD_DEPTH:
                out.append("<blockquote><p>" + md_inline("\n".join(quoted), depth=depth) + "</p></blockquote>")
            else:
                out.append("<blockquote>" + md_blocks(quoted, depth + 1) + "</blockquote>")
            continue
        if _MD_ITEM.match(line):
            flush()
            listed, i = _md_list(lines, i, depth)
            out.append(listed)
            continue
        if "|" in line and i + 1 < n and _md_table_sep(lines[i + 1]):
            flush()
            head = _md_table_cells(line)
            i += 2
            rows = []
            while i < n and lines[i].strip() and "|" in lines[i]:
                rows.append(_md_table_cells(lines[i]))
                i += 1
            cell = lambda tag, text: f"<{tag}>" + md_inline(text, depth=depth) + f"</{tag}>"
            body = "".join("<tr>" + "".join(cell("td", c) for c in row) + "</tr>" for row in rows)
            out.append("<table><thead><tr>" + "".join(cell("th", c) for c in head) + "</tr></thead>"
                       + (f"<tbody>{body}</tbody>" if body else "") + "</table>")
            continue
        para.append(line)
        i += 1
    flush()
    return "\n".join(out)


def render_markdown(text, title):
    """A complete, self-contained HTML page for a Markdown text (standard library only)."""
    return html_page(title, md_blocks(text.splitlines()))


def index_page(root, folder):
    rel = folder.relative_to(root).parts
    title = "/".join((root.name, *rel))
    rows = []
    if rel:
        parent = "/" + "".join(urllib.parse.quote(part, safe="") + "/" for part in rel[:-1])
        rows.append(f'<li><a href="{html.escape(parent)}">..</a></li>')
    try:
        children = sorted(folder.iterdir(), key=lambda child: child.name)
    except OSError:
        children = []
    for child in children:
        if child.name.startswith("."):
            continue
        try:
            real = child.resolve(strict=True)
            mode = real.stat().st_mode
        except (OSError, RuntimeError):
            continue
        if (real != root and not real.is_relative_to(root)) or hidden(real.relative_to(root).parts):
            continue
        is_dir = stat.S_ISDIR(mode)
        if not (is_dir or stat.S_ISREG(mode)):
            continue
        href = "/" + "/".join(urllib.parse.quote(part, safe="") for part in (*rel, child.name)) + ("/" if is_dir else "")
        rows.append(f'<li><a href="{html.escape(href)}">{html.escape(child.name)}{"/" if is_dir else ""}</a></li>')
    body = f"<h1>{html.escape(title)}</h1>\n<ul class=\"index\">\n" + "\n".join(rows) + "\n</ul>"
    if len(rows) == (1 if rel else 0):
        body += "\n<p>This folder is empty.</p>"
    return html_page(title, body)


def make_file_handler(root, quiet=False):
    """A read-only GET/HEAD handler for one file or one folder. Nothing outside `root`, and no dotfile, is served."""
    root = Path(root).resolve(strict=True)
    single = root.is_file()

    class FileHandler(BaseHTTPRequestHandler):
        server_version = "preview"
        sys_version = ""

        def __getattr__(self, name):
            if name.startswith("do_"):
                return self.not_allowed
            raise AttributeError(name)

        def log_message(self, format, *args):
            if not quiet:
                super().log_message(format, *args)

        def send_error(self, code, message=None, explain=None):
            phrase = self.responses.get(code, ("Error",))[0]
            self.send_bytes(code, "text/plain; charset=utf-8", f"{code} {phrase}\n".encode(), OTHER_CSP)

        def not_allowed(self):
            self.send_bytes(405, "text/plain; charset=utf-8", b"Only GET and HEAD are allowed.\n", OTHER_CSP,
                            [("Allow", "GET, HEAD")])

        def not_found(self):
            self.send_bytes(404, "text/plain; charset=utf-8", b"Not found.\n", OTHER_CSP)

        def start(self, code, ctype, length, csp, extra=()):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(length))
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy", csp)
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("Cache-Control", "no-cache")
            for name, value in extra:
                self.send_header(name, value)
            self.end_headers()

        def send_bytes(self, code, ctype, body, csp, extra=()):
            self.start(code, ctype, len(body), csp, extra)
            if self.command != "HEAD":
                self.wfile.write(body)

        def do_GET(self):
            path, _, query = self.path.partition("?")
            target = resolve_request(root, single, path)
            if target is None:
                return self.not_found()
            if target.is_dir():
                return self.send_bytes(200, "text/html; charset=utf-8", index_page(root, target).encode(), HTML_CSP)
            self.send_file(target, query)

        do_HEAD = do_GET

        def send_file(self, target, query):
            flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
            try:
                fd = os.open(target, flags)
            except OSError:
                return self.not_found()
            with os.fdopen(fd, "rb") as f:
                st = os.fstat(f.fileno())
                if not stat.S_ISREG(st.st_mode):
                    return self.not_found()
                name, ext = target.name, target.suffix.lower()
                raw = urllib.parse.parse_qs(query).get("raw") == ["1"]
                if ext in MARKDOWN_EXTS and not raw and st.st_size <= MARKDOWN_RENDER_LIMIT:
                    text = f.read(MARKDOWN_RENDER_LIMIT + 1).decode("utf-8", "replace")
                    return self.send_bytes(200, "text/html; charset=utf-8", render_markdown(text, name).encode(), HTML_CSP)
                extra = []
                if ext in MARKDOWN_EXTS:
                    ctype = "text/plain; charset=utf-8"
                elif ext in INLINE_TYPES:
                    ctype = INLINE_TYPES[ext]
                    extra.append(("Content-Disposition", content_disposition("inline", name)))
                else:
                    head = f.read(TEXT_SNIFF)
                    f.seek(0)
                    if looks_like_text(head):
                        ctype = "text/plain; charset=utf-8"
                    else:
                        ctype = "application/octet-stream"
                        extra.append(("Content-Disposition", content_disposition("attachment", name)))
                self.start(200, ctype, st.st_size, OTHER_CSP, extra)
                if self.command == "HEAD":
                    return
                left = st.st_size
                try:
                    while left > 0:
                        data = f.read(min(CHUNK, left))
                        if not data:  # the file shrank: the promised length cannot be met, so end the connection
                            self.close_connection = True
                            break
                        self.wfile.write(data)
                        left -= len(data)
                except (BrokenPipeError, ConnectionResetError):
                    self.close_connection = True

    return FileHandler


def cmd_serve_file(args):
    try:
        root = check_share_root(args.root)
    except FileShareRefused as e:
        print(f"preview: {e}", file=sys.stderr)
        return EXIT_CONFIG
    if args.port not in FILE_PORTS:
        print(f"preview: file shares use ports {FILE_PORTS.start}-{FILE_PORTS.stop - 1}, not {args.port}", file=sys.stderr)
        return EXIT_CONFIG
    host = check_listen_host("127.0.0.1")  # the file server is never reachable except through the preview proxy
    try:
        server = ThreadingHTTPServer((host, args.port), make_file_handler(root))
    except OSError as e:
        print(f"preview: cannot listen on {host}:{args.port}: {e.strerror or e}", file=sys.stderr)
        return EXIT_CONFIG
    server.daemon_threads = True
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: threading.Thread(target=server.shutdown, daemon=True).start())
    print(f"preview: serving {root} read-only on {host}:{args.port}", flush=True)
    try:
        server.serve_forever()
    finally:
        server.server_close()
    return 0


# ---------------------------------------------------------------------------
# Cua desktops (`preview cua`): an index on 127.0.0.1:18500 (preview-cua-index.service, via `preview _cua-index`) lists
# the Spaces `cua spaces ls --json` knows, live at each request, and every `direct:<host>:<port>` Space gets its own
# owner-only proxy on 18501 and up. Tapping a Space mints a one-hour viewer link with `cua sandbox view` and redirects to
# that Space's share; the ticket travels only in that redirect's URL fragment and is never logged, printed or stored.
# ---------------------------------------------------------------------------

class CuaRefused(ValueError):
    pass


SPACE_ID = re.compile(r"direct:(\d{1,3}(?:\.\d{1,3}){3}|\[[0-9A-Fa-f:]+\]):(\d{1,5})")
PUBLIC_HOST = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?")
CUA_PAGE_CSP = "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
FRAGMENT_OK = re.compile(r"[A-Za-z0-9._~%!$&'()*+,;=:@/?-]+")


def space_address(space_id):
    """(host, port) of a `direct:<host>:<port>` Space a share may reach (loopback or tailnet only), else None."""
    m = SPACE_ID.fullmatch(space_id) if isinstance(space_id, str) else None
    if not m or not 1 <= int(m.group(2)) <= 65535:
        return None
    try:
        return check_listen_host(m.group(1)), int(m.group(2))
    except UnsafeListenAddress:
        return None


def space_upstream(host, port):
    return f"[{host}]:{port}" if ":" in host else f"{host}:{port}"


def parse_spaces(text):
    """([{id, name, host, upstream_port}], [skipped ids]) for the direct Spaces in `cua spaces ls --json`, or None."""
    try:
        data = json.loads(text)
    except (ValueError, TypeError):
        return None
    items = data.get("spaces") if isinstance(data, dict) else data
    if not isinstance(items, list):
        return None
    spaces, skipped, seen = [], [], set()
    for item in items:
        sid = item.get("id") if isinstance(item, dict) else None
        if not isinstance(sid, str) or not sid.startswith("direct:") or sid in seen:
            continue
        seen.add(sid)
        address = space_address(sid)
        if not address:
            skipped.append(printable(sid))
            continue
        name = next((item[k] for k in ("name", "display_name", "label", "title")
                     if isinstance(item.get(k), str) and printable(item[k]).strip()), sid)
        spaces.append({"id": sid, "name": printable(name).strip()[:80], "host": address[0], "upstream_port": address[1]})
    return spaces, skipped


def run_cua(argv, timeout=30):
    """(exit code, stdout) of one cua command; its output is never printed or logged."""
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return done.returncode, done.stdout


def _cua_page(status, title, body):
    headers = [("Content-Type", "text/html; charset=utf-8"), ("Cache-Control", "no-store"),
               ("Content-Security-Policy", CUA_PAGE_CSP), ("Referrer-Policy", "no-referrer"),
               ("X-Content-Type-Options", "nosniff")]
    return status, headers, html_page(title, body).encode()


def with_audio_off(fragment):
    """The viewer's fragment with audio=none (the desktop container has no working sound server)."""
    pairs = [pair for pair in fragment.split("&") if pair and pair.split("=", 1)[0] != "audio"]
    return "&".join(pairs + ["audio=none"])


def cua_index_answer(path, run, cua, public_host, shares):
    """(status, headers, body) for one GET on the index. shares: {Space id: its share port}."""
    path = path.split("?", 1)[0]

    def listed():
        code, out = run([cua, "spaces", "ls", "--json"])
        parsed = parse_spaces(out) if code == 0 else None
        return parsed[0] if parsed else None

    if path == "/":
        spaces = listed()
        if spaces is None:
            return _cua_page(502, "Cua desktops", "<h1>Cua desktops</h1><p>cua could not list the desktops on this "
                                                  "machine. Try again, or run <code>cua spaces ls</code> there.</p>")
        rows = []
        for space in spaces:
            name, port = html.escape(space["name"]), shares.get(space["id"])
            rows.append(f'<li><a href="/open/{port}">{name}</a></li>' if port else
                        f"<li>{name} <small>(not shared yet: run <code>preview cua</code> on the machine)</small></li>")
        body = ('<h1>Cua desktops</h1>\n<ul class="index">\n' + "\n".join(rows) + "\n</ul>\n"
                "<p><small>Tap a desktop to open it. Each tap makes a fresh link for one hour.</small></p>") if rows else \
            "<h1>Cua desktops</h1><p>No Cua desktops are registered on this machine (cua spaces ls).</p>"
        return _cua_page(200, "Cua desktops", body)
    found = re.fullmatch(r"/open/(\d{1,5})", path)
    sid = next((i for i, p in shares.items() if found and p == int(found.group(1))), None)
    if sid is None:
        return _cua_page(404, "Not found", '<p>Not found. <a href="/">All desktops</a></p>')
    spaces = listed()
    if spaces is None:
        return _cua_page(502, "Cua desktops", '<p>cua could not list the desktops. <a href="/">Try again</a></p>')
    if sid not in {space["id"] for space in spaces}:
        return _cua_page(404, "Not found", '<p>This desktop is no longer registered. <a href="/">All desktops</a></p>')
    code, out = run([cua, "sandbox", "view", sid, "--no-open", "--json", "--ttl", "1h"])
    try:
        url = json.loads(out).get("url") if code == 0 else None
        parts = urllib.parse.urlsplit(url) if isinstance(url, str) and not CONTROL_CHARS.search(url) else None
    except (ValueError, TypeError, AttributeError):
        parts = None
    if parts is None or parts.path != "/viewer/" or not FRAGMENT_OK.fullmatch(parts.fragment or ""):
        return _cua_page(502, "Cua desktops", '<p>cua could not open this desktop. <a href="/">Try again</a></p>')
    location = f"https://{public_host}:{shares[sid]}/viewer/#{with_audio_off(parts.fragment)}"
    return 303, [("Location", location), ("Cache-Control", "no-store"), ("Referrer-Policy", "no-referrer")], b""


def make_cua_index_handler(run, cua, public_host, shares):
    """GET/HEAD handler for the index; `shares` returns {Space id: share port} at each request. Logs nothing."""

    class IndexHandler(BaseHTTPRequestHandler):
        server_version = "preview"
        sys_version = ""

        def __getattr__(self, name):
            if name.startswith("do_"):
                return self.not_allowed
            raise AttributeError(name)

        def log_message(self, format, *args):
            pass

        def send_error(self, code, message=None, explain=None):
            self.reply(*_cua_page(code, "Error", f"<p>{int(code)}</p>"))

        def not_allowed(self):
            self.reply(405, [("Content-Type", "text/plain; charset=utf-8"), ("Allow", "GET, HEAD")],
                       b"Only GET and HEAD are allowed.\n")

        def reply(self, status, headers, body):
            self.send_response(status)
            for name, value in headers:
                self.send_header(name, value)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def do_GET(self):
            self.reply(*cua_index_answer(self.path, run, cua, public_host, shares()))

        do_HEAD = do_GET

    return IndexHandler


def cmd_cua_index(args):
    if not os.path.isabs(args.cua) or not os.access(args.cua, os.X_OK):
        print(f"preview: --cua must be the absolute path of the cua program, not {printable(args.cua)!r}", file=sys.stderr)
        return EXIT_CONFIG
    if args.port != CUA_PORT:
        print(f"preview: the Cua desktops index uses port {CUA_PORT}, not {args.port}", file=sys.stderr)
        return EXIT_CONFIG
    if not PUBLIC_HOST.fullmatch(args.public_host):
        print("preview: --public-host must be this machine's tailnet name", file=sys.stderr)
        return EXIT_CONFIG
    os.environ["PREVIEW_STATE_DIR"] = args.state_dir
    host = check_listen_host("127.0.0.1")  # reachable only through the owner-only preview proxy
    shares = lambda: {e["space_id"]: e["port"] for e in all_states() if cua_space_of(e)}
    try:
        server = ThreadingHTTPServer((host, args.port), make_cua_index_handler(run_cua, args.cua, args.public_host, shares))
    except OSError as e:
        print(f"preview: cannot listen on {host}:{args.port}: {e.strerror or e}", file=sys.stderr)
        return EXIT_CONFIG
    server.daemon_threads = True
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: threading.Thread(target=server.shutdown, daemon=True).start())
    print(f"preview: Cua desktops index on {host}:{args.port}", flush=True)
    try:
        server.serve_forever()
    finally:
        server.server_close()
    return 0


# ---------------------------------------------------------------------------
# Unit files (~/.config/systemd/user): every preview is an enabled unit, so it comes back after a reboot
# ---------------------------------------------------------------------------

UNIT_MARKER = "# Written by preview; `preview stop` disables and deletes this file."
UNIT_NAME = re.compile(r"preview-(?:\d{1,5}|file-\d{1,5}|cua-index)(?:\.service)?")
_SYSTEMD_PLAIN = re.compile(r"[A-Za-z0-9_./:@,+=-]+")


def systemd_word(arg):
    """One ExecStart= argument, quoted so systemd passes it through unchanged ($$ and %% are a literal $ and %)."""
    if CONTROL_CHARS.search(arg):
        raise ValueError("refusing a unit command that contains control characters")
    if _SYSTEMD_PLAIN.fullmatch(arg):
        return arg
    return '"' + arg.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%").replace("$", "$$") + '"'


def unit_file_text(description, argv):
    """The unit file of one preview unit: the same command and restart rules the transient units had, plus [Install]."""
    description = printable(description).strip().rstrip("\\").strip().replace("%", "%%") or "preview"
    return "\n".join([
        UNIT_MARKER, "[Unit]", f"Description={description}", "StartLimitIntervalSec=0", "",
        "[Service]", "ExecStart=" + " ".join(systemd_word(arg) for arg in argv), "Restart=on-failure", "RestartSec=2",
        f"RestartPreventExitStatus={EXIT_CONFIG}", "Environment=PYTHONUNBUFFERED=1", "",
        "[Install]", "WantedBy=default.target", ""])


# ---------------------------------------------------------------------------
# System access (tailscale, systemd --user, ss). Tests replace this class.
# ---------------------------------------------------------------------------

class TailnetUnknown(RuntimeError):
    """Tailscale did not report this machine's tailnet name and IP."""


class System:
    def __init__(self):
        self._ts = None

    def run(self, argv, timeout=30):
        try:
            return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        except FileNotFoundError:
            return subprocess.CompletedProcess(argv, 127, "", f"{argv[0]}: not found")
        except subprocess.TimeoutExpired:
            return subprocess.CompletedProcess(argv, 124, "", f"{argv[0]}: timed out")

    def tailnet(self):
        """(tailnet IPv4, MagicDNS name) of this machine; TailnetUnknown when Tailscale cannot say (never a guess)."""
        if self._ts is None:
            r = self.run(["tailscale", "status", "--self", "--peers=false", "--json"], timeout=10)
            ip = name = None
            if r.returncode == 0:
                try:
                    me = json.loads(r.stdout)["Self"]
                    name = me.get("DNSName", "").rstrip(".") or None
                    ip = next((a for a in me.get("TailscaleIPs", []) if "." in a), None)
                except (ValueError, KeyError, TypeError, AttributeError):
                    pass
            if not (ip and name):
                raise TailnetUnknown("tailscale status gave no tailnet name and IP for this machine "
                                     "(is Tailscale running and logged in? check: tailscale status)")
            self._ts = (ip, name)
        return self._ts

    def owner_login(self):
        """The Tailscale login that owns this machine (Self.UserID -> User[id].LoginName), or None."""
        r = self.run(["tailscale", "status", "--json"], timeout=10)
        if r.returncode != 0:
            return None
        try:
            data = json.loads(r.stdout)
            login = data["User"][str(data["Self"]["UserID"])]["LoginName"]
        except (ValueError, KeyError, TypeError):
            return None
        return login if isinstance(login, str) and login.strip() == login and login and not CONTROL_CHARS.search(login) else None

    def cua_spaces(self, cua):
        """parse_spaces of `cua spaces ls --json`, or None when cua could not answer."""
        r = self.run([cua, "spaces", "ls", "--json"], timeout=30)
        return parse_spaces(r.stdout) if r.returncode == 0 else None

    def cua_path(self):
        """The cua program (also in ~/.local/bin, where Cua's installer puts it), as an absolute path, or None."""
        path = os.pathsep.join(p for p in (os.environ.get("PATH", ""), str(Path.home() / ".local/bin")) if p)
        found = shutil.which("cua", path=path)
        return os.path.abspath(found) if found else None

    def operator_ok(self):
        """True/False if we can tell whether this user may change Tailscale Serve, None if unknown."""
        if os.geteuid() == 0:
            return True
        r = self.run(["tailscale", "debug", "prefs"], timeout=10)
        if r.returncode != 0:
            return None
        try:
            op = json.loads(r.stdout).get("OperatorUser") or ""
        except ValueError:
            return None
        return op == current_user()

    def serve_ports(self):
        """Ports that have a Tailscale Serve entry (anyone's)."""
        r = self.run(["tailscale", "serve", "status", "--json"], timeout=10)
        if r.returncode != 0:
            return set()
        try:
            return {int(p) for p in (json.loads(r.stdout or "{}").get("TCP") or {})}
        except (ValueError, AttributeError):
            return set()

    def serve_add(self, port, internal_port):
        r = self.run(["tailscale", "serve", "--bg", "--yes", f"--https={port}", f"http://127.0.0.1:{internal_port}"], timeout=30)
        return r.returncode == 0, (r.stderr or r.stdout).strip()

    def serve_remove(self, port):
        r = self.run(["tailscale", "serve", f"--https={port}", "off"], timeout=30)
        return r.returncode == 0, (r.stderr or r.stdout).strip()

    def unit_state(self, unit):
        r = self.run(["systemctl", "--user", "is-active", unit], timeout=10)
        return (r.stdout or "").strip() or "unknown"

    def unit_dir(self):
        """Where the systemd user manager reads unit files (it does not see this shell's XDG_CONFIG_HOME)."""
        return Path.home() / ".config" / "systemd" / "user"

    def unit_path(self, unit):
        return self.unit_dir() / (unit if unit.endswith(".service") else unit + ".service")

    def has_unit_file(self, unit):
        """True when the unit is a regular file this tool wrote (its first line is UNIT_MARKER)."""
        if not isinstance(unit, str) or not UNIT_NAME.fullmatch(unit):
            return False
        path = self.unit_path(unit)
        try:
            if path.is_symlink() or not path.is_file():
                return False
            with open(path, encoding="utf-8", errors="replace") as f:
                return f.readline().rstrip("\n") == UNIT_MARKER
        except OSError:
            return False

    def own_unit_files(self):
        """Sorted names of the unit files this tool wrote that are still in the unit folder (recorded or not)."""
        try:
            names = [p.name for p in self.unit_dir().iterdir() if UNIT_NAME.fullmatch(p.name)]
        except OSError:
            return []
        return sorted(name for name in names if self.has_unit_file(name))

    def unit_start(self, unit, description, argv):
        """Write the unit file, enable and start it, so the preview comes back after a reboot. A unit an older version
        started with systemd-run (transient) is stopped first; the file then takes its place with the same command."""
        try:
            text = unit_file_text(description, argv)
        except ValueError as e:
            return False, str(e)
        if not UNIT_NAME.fullmatch(unit):
            return False, f"refusing to manage {printable(unit)!r}: not a preview unit"
        path = self.unit_path(unit)
        if (path.exists() or path.is_symlink()) and not self.has_unit_file(unit):
            return False, f"{path} exists and was not written by preview; remove or rename it"
        self.run(["systemctl", "--user", "stop", unit], timeout=20)
        self.run(["systemctl", "--user", "reset-failed", unit], timeout=10)
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_name(f".{path.name}.tmp")
            tmp.write_text(text)
            tmp.chmod(0o644)
            tmp.replace(path)
        except OSError as e:
            return False, f"cannot write {path}: {e.strerror or e}"
        self.run(["systemctl", "--user", "daemon-reload"], timeout=30)
        why = ""
        for verb in ("enable", "start"):
            r = self.run(["systemctl", "--user", verb, unit], timeout=30)
            if r.returncode != 0:
                why = (r.stderr or r.stdout).strip() or f"systemctl --user {verb} {unit} failed"
                break
        else:
            r = self.run(["systemctl", "--user", "show", "-p", "FragmentPath", "--value", unit], timeout=10)
            loaded = (r.stdout or "").strip()
            if not loaded or os.path.realpath(loaded) != os.path.realpath(path):
                why = f"systemd runs {unit} from {printable(loaded) or 'no file'}, not from {path}"
        if why:
            self.unit_stop(unit)  # no half-made unit stays enabled
            return False, why
        return True, ""

    def unit_stop(self, unit):
        """Stop a preview unit; when it is a unit file this tool wrote, also disable and delete that file (nothing else)."""
        ours = self.has_unit_file(unit)
        if ours:
            self.run(["systemctl", "--user", "disable", unit], timeout=20)
        self.run(["systemctl", "--user", "stop", unit], timeout=20)
        self.run(["systemctl", "--user", "reset-failed", unit], timeout=10)
        if ours:
            try:
                self.unit_path(unit).unlink()
            except FileNotFoundError:
                pass
            self.run(["systemctl", "--user", "daemon-reload"], timeout=30)

    def unit_log(self, unit, lines=5):
        r = self.run(["journalctl", "--user", "-u", unit, "-n", str(lines), "--no-pager", "-o", "cat"], timeout=10)
        return (r.stdout or "").strip()

    def listeners(self, port):
        """[(address, process)] of TCP listeners on a port."""
        r = self.run(["ss", "-Hltnp", f"sport = :{port}"], timeout=10)
        out = []
        for line in (r.stdout or "").splitlines():
            cols = line.split()
            if len(cols) < 4:
                continue
            addr = cols[3].rsplit(":", 1)[0].strip("[]").split("%")[0]
            m = re.search(r'users:\(\("([^"]+)"', line)
            out.append((addr, m.group(1) if m else ""))
        return out

    def can_connect(self, host, port, timeout=0.5):
        try:
            with socket.create_connection((host, port), timeout=timeout):
                return True
        except OSError:
            return False

    def free_local_port(self):
        with socket.socket() as s:
            s.bind(("127.0.0.1", 0))
            return s.getsockname()[1]

    def sleep(self, seconds):
        time.sleep(seconds)

    def firewall_tailnet_ports(self, path="/etc/nftables.conf"):
        """Ports the host firewall lets in from the tailnet, or None if it does not restrict them (or is unreadable).

        Tailscale Serve is not affected: tailscaled accepts those connections itself, before this firewall."""
        try:
            text = Path(path).read_text()
        except OSError:
            return None
        if "policy drop" not in text or re.search(r'iifname "tailscale0"\s+accept', text):
            return None
        ports = set()
        for m in re.finditer(r'iifname "tailscale0"[^\n]*?tcp dport (\{[^}]*\}|\d+)[^\n]*accept', text):
            ports.update(int(x) for x in re.findall(r"\d+", m.group(1)))
        return ports


def current_user():
    try:
        import pwd
        return pwd.getpwuid(os.geteuid()).pw_name
    except (ImportError, KeyError):
        return os.environ.get("USER", "")


# ---------------------------------------------------------------------------
# State (one JSON file per preview; only these previews are ever stopped)
# ---------------------------------------------------------------------------

def state_dir():
    return Path(os.environ.get("PREVIEW_STATE_DIR") or Path.home() / ".local/state/preview")


def load_state(port):
    try:
        return json.loads((state_dir() / f"{port}.json").read_text())
    except (OSError, ValueError):
        return None


def save_state(entry):
    d = state_dir()
    d.mkdir(parents=True, exist_ok=True)
    tmp = d / f".{entry['port']}.json.tmp"
    tmp.write_text(json.dumps(entry, indent=2) + "\n")
    tmp.replace(d / f"{entry['port']}.json")


def drop_state(port):
    try:
        (state_dir() / f"{port}.json").unlink()
    except FileNotFoundError:
        pass


def all_states():
    d = state_dir()
    out = []
    for f in sorted(d.glob("*.json"), key=lambda p: int(p.stem) if p.stem.isdigit() else 0) if d.exists() else []:
        try:
            out.append(json.loads(f.read_text()))
        except (OSError, ValueError):
            pass
    return out


