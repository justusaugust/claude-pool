class ProtocolError(Exception):
    pass


async def read_head(reader):
    """Read one HTTP header block. Returns bytes (without the final CRLFCRLF) or None at clean EOF."""
    while True:
        try:
            data = await reader.readuntil(b"\r\n\r\n")
        except asyncio.IncompleteReadError as e:
            if e.partial.strip():
                raise ProtocolError("connection closed inside a header block")
            return None
        except asyncio.LimitOverrunError:
            raise ProtocolError("header block too large")
        data = data.lstrip(b"\r\n")
        if data:
            return data[:-4] if data.endswith(b"\r\n\r\n") else data


def split_head(head):
    lines = head.split(b"\r\n")
    headers = []
    for line in lines[1:]:
        if not line:
            continue
        name, sep, value = line.partition(b":")
        if not sep:
            raise ProtocolError("malformed header line")
        headers.append((name.strip(), value.strip()))
    return lines[0], headers


def join_head(start, headers):
    return start + b"\r\n" + b"".join(n + b": " + v + b"\r\n" for n, v in headers) + b"\r\n"


def _hname(name):
    return (name.encode("latin-1") if isinstance(name, str) else name).lower()


def header(headers, name):
    name = _hname(name)
    for n, v in headers:
        if n.lower() == name:
            return v
    return None


def header_tokens(headers, name):
    out = set()
    name = _hname(name)
    for n, v in headers:
        if n.lower() == name:
            out.update(t.strip().lower() for t in v.split(b","))
    return out


def rewrite_request(headers, target_host, peer_ip=None):
    """Make the request look like it was made on localhost:<port> itself."""
    orig_host = header(headers, "host")
    out = []
    saw_xff = False
    for n, v in headers:
        ln = n.lower()
        if ln == b"host":
            v = target_host
        elif ln in (b"origin", b"referer") and orig_host:
            for scheme in (b"http://", b"https://"):
                pref = scheme + orig_host
                if v == pref or v.startswith(pref + b"/") or v.startswith(pref + b"?"):
                    v = b"http://" + target_host + v[len(pref):]
                    break
        elif ln in (b"x-forwarded-host", b"x-forwarded-proto", b"x-forwarded-port", b"forwarded"):
            continue
        elif ln == b"x-forwarded-for":
            saw_xff = True
        out.append((n, v))
    if orig_host is None:
        out.append((b"Host", target_host))
    if not saw_xff and peer_ip:
        out.append((b"X-Forwarded-For", peer_ip.encode()))
    return out


def rewrite_response(headers, target_port, public_base, upstream=None):
    """Absolute redirects to the local server (or to `upstream`, its host:port) become the preview link."""
    if not public_base:
        return headers
    locals_ = [f"http://{h}:{target_port}".encode() for h in ("localhost", "127.0.0.1", "[::1]")]
    if upstream:
        locals_.append(b"http://" + upstream)
    out = []
    for n, v in headers:
        if n.lower() in (b"location", b"content-location"):
            for local in locals_:
                if v == local or v[len(local):len(local) + 1] in (b"/", b"?", b"#") and v.startswith(local):
                    v = public_base + v[len(local):]
                    break
        out.append((n, v))
    return out


def body_length(headers):
    """Returns ('chunked', None), ('length', n) or ('none', None)."""
    if b"chunked" in header_tokens(headers, "transfer-encoding"):
        return "chunked", None
    cl = [v for n, v in headers if n.lower() == b"content-length"]
    if cl:
        values = {x.strip() for v in cl for x in v.split(b",")}
        if len(values) != 1 or not next(iter(values)).isdigit():
            raise ProtocolError("bad Content-Length")
        return "length", int(next(iter(values)))
    return "none", None


async def copy_n(reader, writer, n):
    while n > 0:
        data = await reader.read(min(n, 65536))
        if not data:
            raise ProtocolError("connection closed inside a body")
        writer.write(data)
        await writer.drain()
        n -= len(data)


async def copy_chunked(reader, writer):
    while True:
        line = await reader.readuntil(b"\r\n")
        writer.write(line)
        try:
            size = int(line.split(b";")[0].strip(), 16)
        except ValueError:
            raise ProtocolError("bad chunk size")
        if size == 0:
            while True:  # trailers, then the empty line
                line = await reader.readuntil(b"\r\n")
                writer.write(line)
                if line == b"\r\n":
                    await writer.drain()
                    return
        await copy_n(reader, writer, size + 2)


async def copy_all(reader, writer):
    while True:
        data = await reader.read(65536)
        if not data:
            break
        writer.write(data)
        await writer.drain()
    try:
        if writer.can_write_eof():
            writer.write_eof()
    except (OSError, RuntimeError):
        pass


def unavailable_page(port, where=None):
    where = html.escape(where or f"localhost:{port}")
    body = (
        "<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width'>"
        "<meta http-equiv=refresh content=3><title>Waiting for %s</title>"
        "<body style='font:16px/1.5 system-ui;margin:3rem auto;max-width:34rem;padding:0 1rem'>"
        "<h1 style='font-size:1.3rem'>Nothing is answering on %s yet</h1>"
        "<p>The preview link works, but the server behind it is not running or still starting. "
        "This page reloads every 3 seconds.</p>" % (where, where)
    ).encode()
    return (b"HTTP/1.1 502 Bad Gateway\r\nContent-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n"
            b"Connection: close\r\nContent-Length: " + str(len(body)).encode() + b"\r\n\r\n" + body)


MISDIRECTED = (b"HTTP/1.1 421 Misdirected Request\r\nContent-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\n"
               b"Connection: close\r\nContent-Length: 46\r\n\r\nThis preview answers only its own tailnet name.")


def plain_answer(status, text, extra=b""):
    """A complete short plain-text response that ends the connection."""
    body = text.encode()
    return (b"HTTP/1.1 " + status + b"\r\nContent-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\n" + extra +
            b"Connection: close\r\nContent-Length: " + str(len(body)).encode() + b"\r\n\r\n" + body)


# The Cua desktops share (`preview cua`): its proxies let through only the Tailscale login that owns this machine.
# Tailscale Serve sets Tailscale-User-Login itself and drops any copy a client sends, so these proxies listen on
# loopback only, behind Serve.
FORBIDDEN = plain_answer(b"403 Forbidden", "This link is only for the owner of this machine.\n")


def local_address(text):
    """True when this machine has the address (its tailnet IPv4 or IPv6, loopback): a request that came from here."""
    try:
        ip = ipaddress.ip_address(text.strip("[]"))
    except ValueError:
        return False
    if ip.is_loopback:
        return True
    with socket.socket(socket.AF_INET6 if ip.version == 6 else socket.AF_INET, socket.SOCK_STREAM) as probe:
        try:
            probe.bind((str(ip), 0))
            return True
        except OSError:
            return False


def split_host(value):
    """(host, port or None) of a Host header value, lower case, without a trailing dot; None when it is not one."""
    try:
        text = value.decode("ascii").strip().lower()
    except UnicodeDecodeError:
        return None
    match = re.fullmatch(r"(\[[0-9a-f:.]+\]|[a-z0-9.-]+)(?::([0-9]{1,5}))?", text)
    if not match:
        return None
    return match.group(1).rstrip("."), int(match.group(2)) if match.group(2) else None


class Proxy:
    def __init__(self, target_port, public_base=None, target_hosts=("127.0.0.1", "::1"), tailnet_ip=None, listen_port=None,
                 upstream_host=None, upstream_port=None, owner_login=None, state_file=None, listen=None):
        self.target_port = target_port  # the share's port (its link); the server behind it is upstream_host:upstream_port
        # opened_at: the state file of this preview (only the record whose listen address is this proxy's is updated)
        self.state_file, self.listen, self.own_ip = state_file, listen, tailnet_ip
        self.opened_noted = None
        self.upstream_port = upstream_port or target_port
        host = upstream_host or "localhost"
        self.upstream = (f"[{host}]" if ":" in host else host) + f":{self.upstream_port}"
        self.target_host_header = self.upstream.encode()
        self.public_base = public_base.rstrip("/").encode() if public_base else None
        self.target_hosts = (upstream_host,) if upstream_host else target_hosts
        # Cua desktops share only: the one Tailscale login let through.
        self.owner_login = owner_login.encode() if owner_login is not None else None
        # DNS rebinding guard: a request is served only when its Host names this machine on the tailnet (MagicDNS name,
        # its short form, the tailnet IPv4) or localhost, with the share's port. Rewriting Host would otherwise defeat a
        # dev server's own rebinding check, and any web page could read the share through a rebound name.
        names, ports = {"localhost", "127.0.0.1"}, {target_port}
        if tailnet_ip:
            names.add(tailnet_ip)
        if public_base:
            public = urllib.parse.urlsplit(public_base)
            if public.hostname:
                names.add(public.hostname.rstrip(".").lower())
                names.add(public.hostname.split(".")[0].lower())
            if public.port:
                ports.add(public.port)
        if listen_port:
            ports.add(listen_port)
        self.allowed_names, self.allowed_ports = names, ports

    def host_allowed(self, headers):
        value = header(headers, "host")
        found = split_host(value) if value is not None else None
        if not found:
            return False
        name, port = found
        return name in self.allowed_names and (port is None or port in self.allowed_ports)

    def login_ok(self, headers):
        """True when the request carries exactly one Tailscale-User-Login and it is the owner's (Cua share only)."""
        if self.owner_login is None:
            return True
        logins = [v for n, v in headers if n.lower() == b"tailscale-user-login"]
        return len(logins) == 1 and logins[0] == self.owner_login

    def note_open(self, headers):
        """A person opened the preview: Tailscale Serve sent the request with their identity (Tailscale-User-Login),
        and not from this machine itself (an agent checking the link). Records the time as opened_at in the state file,
        at most once a minute, in a worker thread, so the request never waits for it. The login is not stored."""
        if self.state_file is None or header(headers, "tailscale-user-login") is None:
            return
        forwarded = header(headers, "x-forwarded-for")  # Tailscale Serve: the address the request came from
        source = forwarded.split(b",")[0].strip().decode("latin-1") if forwarded else ""
        if source and (source == self.own_ip or local_address(source)):
            return
        now = time.monotonic()
        if self.opened_noted is not None and now - self.opened_noted < OPENED_EVERY:
            return
        self.opened_noted = now
        asyncio.get_running_loop().run_in_executor(None, record_opened, self.state_file, self.listen, int(time.time()))

    async def connect_upstream(self):
        last = None
        for host in self.target_hosts:
            try:
                return await asyncio.open_connection(host, self.upstream_port, limit=1 << 20)
            except OSError as e:
                last = e
        raise last or OSError("no upstream")

    async def handle(self, creader, cwriter):
        peer = cwriter.get_extra_info("peername")
        peer_ip = peer[0] if peer else None
        uwriter = None
        try:
            head = await read_head(creader)
            if head is None:
                return
            if not self.host_allowed(split_head(head)[1]):
                cwriter.write(MISDIRECTED)
                await cwriter.drain()
                return
            if not self.login_ok(split_head(head)[1]):
                cwriter.write(FORBIDDEN)  # nothing reaches the server behind this share
                await cwriter.drain()
                return
            self.note_open(split_head(head)[1])  # also when the server behind it is down
            try:
                ureader, uwriter = await self.connect_upstream()
            except OSError:
                cwriter.write(unavailable_page(self.target_port, self.upstream if self.owner_login is not None else None))
                await cwriter.drain()
                return
            pending = asyncio.Queue()
            open_ = [0]  # requests forwarded whose response has not been written in full yet
            up = asyncio.ensure_future(self.client_to_upstream(head, creader, uwriter, pending, peer_ip, cwriter, open_))
            down = asyncio.ensure_future(self.upstream_to_client(ureader, cwriter, pending, open_))
            done, _ = await asyncio.wait({up, down}, return_when=asyncio.FIRST_COMPLETED)
            if down in done:
                up.cancel()
            else:
                await down
            for t in (up, down):
                if t.done() and not t.cancelled() and t.exception():
                    pass
        except (ProtocolError, OSError, asyncio.IncompleteReadError, asyncio.LimitOverrunError):
            pass
        finally:
            for w in (cwriter, uwriter):
                if w is not None:
                    w.close()

    async def client_to_upstream(self, head, creader, uwriter, pending, peer_ip, cwriter=None, open_=None):
        open_ = open_ if open_ is not None else [0]
        try:
            while head is not None:
                start, headers = split_head(head)
                if not self.host_allowed(headers):
                    break  # a foreign Host later on the connection: earlier answers finish, nothing more reaches the server
                if not self.login_ok(headers):
                    if open_[0] == 0 and cwriter is not None:  # answer only in order; a pipelined one just ends it
                        cwriter.write(FORBIDDEN)
                        await cwriter.drain()
                    break
                method = start.split(b" ", 1)[0].upper()
                self.note_open(headers)
                headers = rewrite_request(headers, self.target_host_header, peer_ip)
                upgrade = b"upgrade" in header_tokens(headers, "connection") and header(headers, "upgrade") is not None
                pending.put_nowait(method)
                if not upgrade and method != b"CONNECT":
                    open_[0] += 1
                uwriter.write(join_head(start, headers))
                await uwriter.drain()
                if upgrade or method == b"CONNECT":
                    await copy_all(creader, uwriter)  # WebSocket: raw bytes both ways from here
                    return
                kind, n = body_length(headers)
                if kind == "chunked":
                    await copy_chunked(creader, uwriter)
                elif kind == "length":
                    await copy_n(creader, uwriter, n)
                head = await read_head(creader)
            if uwriter.can_write_eof():
                uwriter.write_eof()
        except (ProtocolError, OSError, asyncio.IncompleteReadError, asyncio.LimitOverrunError):
            try:
                uwriter.close()
            except Exception:
                pass

    async def upstream_to_client(self, ureader, cwriter, pending, open_=None):
        open_ = open_ if open_ is not None else [0]
        try:
            while True:
                head = await read_head(ureader)
                if head is None:
                    return
                start, headers = split_head(head)
                parts = start.split(b" ", 2)
                code = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 0
                if 100 <= code < 200 and code != 101:
                    cwriter.write(join_head(start, headers))
                    await cwriter.drain()
                    continue
                method = pending.get_nowait() if not pending.empty() else b"GET"
                headers = rewrite_response(headers, self.target_port, self.public_base, self.target_host_header)
                cwriter.write(join_head(start, headers))
                await cwriter.drain()
                if code == 101 or (method == b"CONNECT" and 200 <= code < 300):
                    await copy_all(ureader, cwriter)
                    return
                if method == b"HEAD" or code in (204, 304):
                    open_[0] -= 1
                    continue
                kind, n = body_length(headers)
                if kind == "chunked":
                    await copy_chunked(ureader, cwriter)
                elif kind == "length":
                    await copy_n(ureader, cwriter, n)
                else:  # body ends when the server closes the connection
                    await copy_all(ureader, cwriter)
                    return
                open_[0] -= 1
        except (ProtocolError, OSError, asyncio.IncompleteReadError, asyncio.LimitOverrunError):
            return


def address_missing(host):
    """True when no interface carries this address yet (EADDRNOTAVAIL), e.g. tailscale0 just after a reboot."""
    with socket.socket(socket.AF_INET6 if ":" in host else socket.AF_INET, socket.SOCK_STREAM) as probe:
        try:
            probe.bind((host.strip("[]"), 0))
        except OSError as e:
            return e.errno == errno.EADDRNOTAVAIL
    return False


async def start_proxy_server(listen_host, listen_port, proxy):
    listen_host = check_listen_host(listen_host)  # the bind-address guarantee, enforced at the socket
    return await asyncio.start_server(proxy.handle, listen_host, listen_port, limit=1 << 20, reuse_address=True)


# On demand (socket activation): the unit's .socket keeps the port open; systemd starts the server at a connection and
# hands it the listening socket as fd 3. The server stops after --idle seconds without an open connection; connections
# that come while it starts or stops wait in the socket's queue for the next start.

def inherited_socket(environ=None, pid=None, fd=None):
    """The listening socket systemd passed this process (LISTEN_PID is this process, LISTEN_FDS >= 1), or None, so the
    server binds as before. The variables are removed, so no child process takes them for its own."""
    environ = os.environ if environ is None else environ
    fd = SD_LISTEN_FDS_START if fd is None else fd
    try:
        mine = int(environ.get("LISTEN_PID", "")) == (os.getpid() if pid is None else pid)
        count = int(environ.get("LISTEN_FDS", ""))
    except ValueError:
        return None
    if not mine or count < 1:
        return None
    for name in ("LISTEN_PID", "LISTEN_FDS", "LISTEN_FDNAMES"):
        environ.pop(name, None)
    os.set_inheritable(fd, False)
    sock = socket.socket(fileno=fd)
    if sock.type != socket.SOCK_STREAM or not sock.getsockopt(socket.SOL_SOCKET, socket.SO_ACCEPTCONN):
        sock.close()
        raise OSError(errno.EINVAL, "the socket from systemd is not a listening TCP socket")
    return sock


def check_inherited(sock, host, port):
    """The bind-address guarantee for a socket systemd bound: exactly the address this server was told to listen on."""
    got_host, got_port = sock.getsockname()[:2]
    check_listen_host(got_host)
    if ipaddress.ip_address(got_host) != ipaddress.ip_address(host.strip("[]")) or got_port != port:
        raise UnsafeListenAddress(f"the socket from systemd listens on {got_host}:{got_port}, not {host}:{port}")


def sd_notify(message):
    """Tell systemd how the unit is doing (READY=1 for Type=notify); does nothing outside systemd."""
    addr = os.environ.get("NOTIFY_SOCKET", "")
    if not addr or addr[0] not in "/@":
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.sendto(message.encode(), "\0" + addr[1:] if addr[0] == "@" else addr)
        return True
    except OSError:
        return False


class IdleCount:
    """Open connections, and for how long none has been (0 while one is open)."""

    def __init__(self, clock=time.monotonic):
        self.clock, self.lock, self.open, self.since = clock, threading.Lock(), 0, clock()

    def opened(self):
        with self.lock:
            self.open += 1

    def closed(self):
        with self.lock:
            self.open -= 1
            self.since = self.clock()

    def idle_for(self):
        with self.lock:
            return 0.0 if self.open > 0 else self.clock() - self.since


class OnDemandServer:
    """Serves `handle` on a listening socket from systemd and counts the open connections. Accepting and counting happen
    in one step, so stopping when idle never drops a connection: one not accepted yet waits in the socket's queue, and
    systemd starts the server again for it. WebSockets and streams are open connections, so they keep it running."""

    def __init__(self, sock, handle, limit=1 << 20):
        self.sock, self.handle, self.limit = sock, handle, limit
        self.idle = IdleCount()
        self.loop, self.closed, self.idled = None, False, False
        # The connections' tasks, held until done: the loop keeps tasks only weakly, and a stream's protocol holds its
        # reader weakly, so a connection waiting on a read is otherwise garbage, and collecting it drops the request.
        self.tasks = set()

    def start(self):
        self.loop = asyncio.get_running_loop()
        self.sock.setblocking(False)
        self.loop.add_reader(self.sock.fileno(), self._accept)

    def _accept(self):
        for _ in range(64):
            try:
                conn, _ = self.sock.accept()
            except (BlockingIOError, InterruptedError):
                return
            except OSError as e:
                if e.errno in (errno.EMFILE, errno.ENFILE, errno.ENOBUFS, errno.ENOMEM):  # out of descriptors: wait a second
                    self.loop.remove_reader(self.sock.fileno())
                    self.loop.call_later(1.0, self._resume)
                return
            self.idle.opened()
            task = self.loop.create_task(self._serve(conn))
            self.tasks.add(task)
            task.add_done_callback(self.tasks.discard)

    def _resume(self):
        if not self.closed:
            self.loop.add_reader(self.sock.fileno(), self._accept)

    async def _serve(self, conn):
        try:
            try:
                reader, writer = await asyncio.open_connection(sock=conn, limit=self.limit)
            except OSError:
                conn.close()
                return
            try:
                await self.handle(reader, writer)
            finally:
                writer.close()
        finally:
            self.idle.closed()

    async def stop_when_idle(self, seconds, stop):
        while not self.closed:
            left = seconds - self.idle.idle_for()
            if left <= 0:
                self.idled = True
                self.close()  # in the same step as the check: nothing is accepted after it
                stop.set()
                return
            await asyncio.sleep(left)

    def close(self):
        if self.closed:
            return
        self.closed = True
        try:
            self.loop.remove_reader(self.sock.fileno())
        except (ValueError, OSError):
            pass
        self.sock.close()


def cmd_serve(args):
    host, port = parse_hostport(args.listen)
    try:
        check_listen_host(host)
    except UnsafeListenAddress as e:
        print(f"preview: {e}", file=sys.stderr)
        return EXIT_CONFIG
    gate = (args.owner_login, args.upstream_host, args.upstream_port)
    if any(x is not None for x in gate):
        # A Cua share: a login gate is only a gate behind Tailscale Serve, which sets the login header (a proxy on the
        # tailnet IP would accept a forged one), and its upstream is a loopback or tailnet address, nothing else.
        ok = None not in gate and bool(args.owner_login) and ipaddress.ip_address(host.strip("[]")).is_loopback
        try:
            ok = ok and bool(check_listen_host(args.upstream_host)) and 1 <= args.upstream_port <= 65535
        except UnsafeListenAddress:
            ok = False
        if not ok:
            print("preview: a Cua share needs --owner-login, --upstream-host (loopback or tailnet) and --upstream-port, "
                  "and listens on 127.0.0.1 only", file=sys.stderr)
            return EXIT_CONFIG
    try:
        sock = inherited_socket()
        if sock is not None:
            check_inherited(sock, host, port)
    except (OSError, UnsafeListenAddress) as e:
        print(f"preview: cannot use the socket from systemd: {e}", file=sys.stderr)
        return EXIT_CONFIG
    proxy = Proxy(args.target, args.public_url, tailnet_ip=args.tailnet_ip, listen_port=port,
                  upstream_host=args.upstream_host, upstream_port=args.upstream_port, owner_login=args.owner_login,
                  state_file=state_dir() / f"{args.target}.json", listen=args.listen)

    async def main():
        if sock is not None:
            server = OnDemandServer(sock, proxy.handle)
            server.start()
        else:
            try:
                server = await start_proxy_server(host, port, proxy)
            except OSError as e:
                print(f"preview: cannot listen on {host}:{port}: {e.strerror or e}", file=sys.stderr)
                # After a reboot the unit can start before tailscale0 has its address: exit so systemd tries again.
                return 1 if address_missing(host) else EXIT_CONFIG
        stop = asyncio.Event()
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGINT):
            loop.add_signal_handler(sig, stop.set)
        on_demand = f" (socket from systemd, stops after {args.idle:g} s idle)" if sock is not None and args.idle else ""
        print(f"preview: {host}:{port} -> localhost:{args.target}" + (f" ({args.public_url})" if args.public_url else "")
              + on_demand, flush=True)
        sd_notify("READY=1")
        if on_demand:
            idler = loop.create_task(server.stop_when_idle(args.idle, stop))  # held while main waits (tasks are weak)
        await stop.wait()
        if sock is not None:
            server.close()
            if server.idled:
                print(f"preview: no connection for {args.idle:g} s; the socket starts this proxy again at the next one",
                      flush=True)
            return 0
        server.close()
        if hasattr(server, "close_clients"):  # Python 3.13: do not wait for idle keep-alive clients
            server.close_clients()
        return 0

    return asyncio.run(main())


