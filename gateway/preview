def self_path():
    return os.path.realpath(__file__)


def links(sysm, port):
    _, name = sysm.tailnet()
    return f"https://{name}:{port}", f"http://{name}:{port}"


def target_listening(sysm, port):
    return sysm.can_connect("127.0.0.1", port) or sysm.can_connect("::1", port)


def wildcard_or_public(addr, ts_ip):
    if addr in ("*", "0.0.0.0", "::"):
        return True
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return False
    return not (ip.is_loopback or any(ip in n for n in TAILNET_NETS) or ip.is_link_local)


def guess_label(sysm, port):
    for addr, proc in sysm.listeners(port):
        if proc and addr in ("127.0.0.1", "::1"):
            return proc
    return f"port {port}"


def wait_listening(sysm, host, port, seconds=4.0):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if sysm.can_connect(host, port, timeout=0.3):
            return True
        sysm.sleep(0.15)
    return False


def start_unit(sysm, entry):
    unit = entry["unit"]
    host, lport = parse_hostport(entry["listen"])
    argv = ["/usr/bin/python3", "-I", self_path(), "_serve", "--listen", entry["listen"],
            "--target", str(entry["port"]), "--public-url", entry["link"]]
    ok, err = sysm.unit_start(unit, f"preview {entry['port']}: {entry['label']}", argv)
    if not ok:
        return False, err or "systemd-run failed"
    if not wait_listening(sysm, host, lport):
        log = sysm.unit_log(unit)
        sysm.unit_stop(unit)
        return False, log or f"proxy did not start listening on {entry['listen']}"
    return True, ""


def entry_healthy(sysm, entry):
    if sysm.unit_state(entry["unit"]) != "active":
        return False
    host, lport = parse_hostport(entry["listen"])
    if not sysm.can_connect(host, lport, timeout=0.5):
        return False
    if entry["backend"] == "https" and entry["port"] not in sysm.serve_ports():
        return False
    return True


def note_for(entry, listening, sysm=None):
    port = entry["port"]
    parts = []
    if entry["backend"] == "https":
        parts.append(f"HTTPS via Tailscale Serve to localhost:{port}, tailnet devices only.")
    else:
        parts.append(f"HTTP to localhost:{port}, tailnet devices only. HTTP until Tailscale Serve is enabled (preview doctor).")
        allowed = sysm.firewall_tailnet_ports() if sysm else None
        if allowed is not None and port not in allowed:
            parts.append(f"Warning: the VPS firewall only lets tailnet traffic reach ports {', '.join(map(str, sorted(allowed))) or 'none'}, "
                         f"so this HTTP link will not load. Fix: enable Tailscale Serve (preview doctor), then run preview {port} again.")
    if not listening:
        parts.append(f"Nothing listens on localhost:{port} yet; the page waits for it.")
    parts.append(f"Stop: preview stop {port}")
    return "  " + " ".join(parts)


def cmd_start(sysm, port, label=None, out=None, err=None):
    out, err = out or sys.stdout, err or sys.stderr
    ts_ip, _ = sysm.tailnet()
    https_link, http_link = links(sysm, port)
    existing = load_state(port)

    exposed = [a for a, _ in sysm.listeners(port) if wildcard_or_public(a, ts_ip)]
    if exposed:
        print(f"preview: something on this VPS already listens on {exposed[0]}:{port}, which includes the public "
              f"internet. Restart the dev server bound to 127.0.0.1 (for example --host 127.0.0.1), then run "
              f"preview {port} again.", file=err)
        return 1
    others_serve = sysm.serve_ports() - ({port} if existing and existing.get("backend") == "https" else set())
    if port in others_serve:
        print(f"preview: Tailscale Serve already uses port {port} for something else; pick another port.", file=err)
        return 1

    label = label or (existing or {}).get("label") or guess_label(sysm, port)
    operator = sysm.operator_ok()
    forced = os.environ.get("PREVIEW_BACKEND", "")

    if existing and entry_healthy(sysm, existing):
        upgrade = existing["backend"] == "http" and operator is True and forced != "http"
        if not upgrade:
            if label != existing.get("label"):
                existing["label"] = label
                save_state(existing)
            print(existing["link"], file=out)
            print(note_for(existing, target_listening(sysm, port), sysm), file=err)
            return 0
    if existing:
        stop_entry(sysm, existing, quiet=True)

    entry = None
    serve_error = ""
    if forced != "http" and (operator is not False or forced == "https"):
        internal = sysm.free_local_port()
        ok, serve_error = sysm.serve_add(port, internal)
        if ok:
            entry = {"port": port, "label": label, "backend": "https", "link": https_link,
                     "listen": f"127.0.0.1:{internal}", "unit": f"{UNIT_PREFIX}{port}", "created": int(time.time())}
            started, msg = start_unit(sysm, entry)
            if not started:
                sysm.serve_remove(port)
                print(f"preview: could not start the proxy for port {port}: {msg}", file=err)
                return 1
    if entry is None:
        if forced == "https":
            print(f"preview: Tailscale Serve is not available: {serve_error or 'not permitted'}", file=err)
            return 1
        entry = {"port": port, "label": label, "backend": "http", "link": http_link,
                 "listen": f"{ts_ip}:{port}", "unit": f"{UNIT_PREFIX}{port}", "created": int(time.time())}
        started, msg = start_unit(sysm, entry)
        if not started:
            print(f"preview: could not start the proxy for port {port}: {msg}", file=err)
            return 1
    save_state(entry)
    print(entry["link"], file=out)
    print(note_for(entry, target_listening(sysm, port), sysm), file=err)
    return 0


def stop_entry(sysm, entry, quiet=False):
    sysm.unit_stop(entry["unit"])
    if entry.get("backend") == "https":
        sysm.serve_remove(entry["port"])
    drop_state(entry["port"])


def cmd_stop(sysm, port=None, all_=False, out=None, err=None):
    out, err = out or sys.stdout, err or sys.stderr
    if all_:
        entries = all_states()
        for e in entries:
            stop_entry(sysm, e)
            print(f"stopped {e['port']} ({e['label']})", file=out)
        if not entries:
            print("no previews running", file=out)
        return 0
    entry = load_state(port)
    if not entry:
        print(f"preview: no preview on port {port} (see preview list)", file=err)
        return 1
    stop_entry(sysm, entry)
    print(f"stopped {port} ({entry['label']})", file=out)
    return 0


def cmd_list(sysm, as_json=False, out=None):
    out = out or sys.stdout
    rows = []
    for e in all_states():
        rows.append({**e, "target_listening": target_listening(sysm, e["port"]),
                     "proxy": sysm.unit_state(e["unit"])})
    if as_json:
        print(json.dumps(rows, indent=2), file=out)
        return 0
    if not rows:
        print("no previews running (start one with: preview <port>)", file=out)
        return 0
    table = [("PORT", "LABEL", "BACKEND", "TARGET", "PROXY", "LINK")]
    for r in rows:
        table.append((str(r["port"]), r["label"], r["backend"], "listening" if r["target_listening"] else "not listening",
                      r["proxy"], r["link"]))
    widths = [max(len(row[i]) for row in table) for i in range(len(table[0]))]
    for row in table:
        print("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip(), file=out)
    return 0


def cmd_doctor(sysm, out=None):
    out = out or sys.stdout
    ts_ip, name = sysm.tailnet()
    operator = sysm.operator_ok()
    user = current_user()
    print(f"tailnet name   {name}", file=out)
    print(f"tailnet IP     {ts_ip}", file=out)
    if operator is True:
        print("backend        https (Tailscale Serve is allowed for this user)", file=out)
        print(f"links look like https://{name}:<port>", file=out)
        stale = [e["port"] for e in all_states() if e.get("backend") == "http"]
        if stale:
            print(f"upgrade        these previews are still HTTP; run preview <port> again: {', '.join(map(str, stale))}", file=out)
    else:
        why = "not allowed for this user" if operator is False else "could not check"
        print(f"backend        http (Tailscale Serve {why}; links look like http://{name}:<port>)", file=out)
        print("enable HTTPS   run once on the VPS as an admin (needs sudo):", file=out)
        print(f"                 sudo tailscale set --operator={user}", file=out)
        print("               then run preview <port> again for each open preview; it switches to https://", file=out)
    allowed = sysm.firewall_tailnet_ports()
    if allowed is not None:
        print(f"firewall       tailnet traffic to the VPS itself is limited to ports {', '.join(map(str, sorted(allowed)))};", file=out)
        print("               the HTTP backend only works on those ports, HTTPS via Tailscale Serve works on any port", file=out)
    r = sysm.run(["systemctl", "--user", "is-system-running"], timeout=10)
    print(f"systemd --user {(r.stdout or r.stderr).strip() or 'unknown'}", file=out)
    linger = sysm.run(["loginctl", "show-user", user, "-p", "Linger", "--value"], timeout=10).stdout.strip()
    print(f"linger         {linger or 'unknown'} (yes = previews keep running after logout)", file=out)
    print(f"previews       {len(all_states())} open (preview list)", file=out)
    return 0


